+  process.stdout.write(`PHASE27_PASS paste=${pasted.characters}chars imageToTxt=${ocr.text.length}chars/${ocr.words.length}words autoVault=opt-in lockedGuard=${locked.reason} workflow=preserved output=${textPath}\n`);
