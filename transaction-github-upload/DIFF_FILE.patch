diff --git a/moyin/src/services/batch-export-service.cjs b/moyin/src/services/batch-export-service.cjs
new file mode 100644
index 0000000..7cf39c2
--- /dev/null
+++ b/moyin/src/services/batch-export-service.cjs
@@ -0,0 +1,172 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { constants } = require('node:fs');
+
+const AUDIT_FORMAT = 'VEILFORGE_BATCH_AUDIT';
+const MANIFEST_FORMAT = 'VEILFORGE_BATCH_MANIFEST';
+
+function cleanStem(value) {
+  return String(value || 'document')
+    .replace(/[<>:"/\\|?*\u0000-\u001f]/gu, '_')
+    .replace(/[. ]+$/u, '')
+    .trim()
+    .slice(0, 120) || 'document';
+}
+
+function outputFileName(result) {
+  const parsed = path.parse(String(result?.name || 'document.txt'));
+  const stem = `${cleanStem(parsed.name)}-脱敏`;
+  if (result?.office?.kind === 'docx' || result?.office?.kind === 'xlsx') return `${stem}.${result.office.kind}`;
+  if (result?.image?.kind === 'pdf') return `${stem}.pdf`;
+  if (result?.image?.kind === 'image') return `${stem}.png`;
+  const extension = /^\.[a-z0-9]{1,8}$/iu.test(result?.extension || '') ? result.extension.toLowerCase() : '.txt';
+  return `${stem}${extension}`;
+}
+
+async function exists(filePath) {
+  try {
+    await fs.access(filePath);
+    return true;
+  } catch (error) {
+    if (error?.code === 'ENOENT') return false;
+    throw error;
+  }
+}
+
+async function availablePath(directory, fileName, reserved, includeAuditSidecar = false) {
+  const parsed = path.parse(fileName);
+  for (let counter = 1; counter <= 9999; counter += 1) {
+    const suffix = counter === 1 ? '' : ` (${counter})`;
+    const candidate = path.join(directory, `${parsed.name}${suffix}${parsed.ext}`);
+    const key = candidate.toLocaleLowerCase('en-US');
+    if (reserved.has(key) || await exists(candidate)) continue;
+    if (includeAuditSidecar && await exists(`${candidate}.audit.json`)) continue;
+    reserved.add(key);
+    return candidate;
+  }
+  throw new Error('LOCAL_BATCH_EXPORT_NAME_EXHAUSTED');
+}
+
+function safeFindings(findings) {
+  return findings.map(({ type, label, start, end, replacement }) => ({ type, label, start, end, replacement }));
+}
+
+async function renderJob(job, directory, handlers, reserved) {
+  const result = job?.result;
+  if (!result || typeof result.text !== 'string') throw new Error('LOCAL_BATCH_EXPORT_RESULT_INVALID');
+  const analysis = await handlers.analyzeText(result.text);
+  const findings = Array.isArray(analysis?.findings) ? analysis.findings : [];
+  const redactedText = analysis.redactedText ?? await handlers.applyFindings(result.text, findings);
+  const outputPath = await availablePath(directory, outputFileName(result), reserved, true);
+  const auditPath = `${outputPath}.audit.json`;
+  let render = { unchanged: findings.length === 0 };
+  try {
+    if (result.csv) {
+      if (typeof handlers.renderCsv !== 'function') throw new Error('LOCAL_BATCH_EXPORT_HANDLER_REQUIRED:renderCsv');
+      render = await handlers.renderCsv(result.csv, redactedText, outputPath);
+    } else if (!findings.length) {
+      await fs.copyFile(job.input, outputPath, constants.COPYFILE_EXCL);
+      render.bytes = (await fs.stat(outputPath)).size;
+    } else if (result.office) {
+      render = await handlers.renderOffice(result.office, findings, outputPath);
+    } else if (result.image?.kind === 'pdf') {
+      render = await handlers.renderPdf(result.image, findings, outputPath);
+    } else if (result.image?.kind === 'image') {
+      render = await handlers.renderImage(result.image, findings, outputPath);
+    } else {
+      await fs.writeFile(outputPath, redactedText, { encoding: 'utf8', flag: 'wx' });
+      render = { bytes: Buffer.byteLength(redactedText, 'utf8'), characters: redactedText.length };
+    }
+    const audit = {
+      format: AUDIT_FORMAT,
+      version: 1,
+      exportedAt: new Date().toISOString(),
+      sourceName: result.name,
+      sourceExtension: result.extension,
+      sourceBytes: result.sourceBytes,
+      outputName: path.basename(outputPath),
+      findingCount: findings.length,
+      findings: safeFindings(findings),
+      render
+    };
+    await fs.writeFile(auditPath, `${JSON.stringify(audit, null, 2)}\n`, { encoding: 'utf8', flag: 'wx' });
+    return {
+      id: job.id,
+      sourceName: result.name,
+      outputPath,
+      auditPath,
+      findingCount: findings.length,
+      findingTypes: [...new Set(findings.map((item) => String(item.type || 'custom')))],
+      vaultText: redactedText,
+      render
+    };
+  } catch (error) {
+    await fs.rm(outputPath, { force: true }).catch(() => {});
+    await fs.rm(auditPath, { force: true }).catch(() => {});
+    throw error;
+  }
+}
+
+async function exportBatchResults(jobs, directory, handlers = {}) {
+  if (!Array.isArray(jobs) || !jobs.length) throw new Error('LOCAL_BATCH_EXPORT_EMPTY');
+  const stats = await fs.stat(directory);
+  if (!stats.isDirectory()) throw new Error('LOCAL_BATCH_EXPORT_DIRECTORY_INVALID');
+  for (const name of ['analyzeText', 'applyFindings', 'renderOffice', 'renderPdf', 'renderImage']) {
+    if (typeof handlers[name] !== 'function') throw new Error(`LOCAL_BATCH_EXPORT_HANDLER_REQUIRED:${name}`);
+  }
+  const reserved = new Set();
+  const records = [];
+  const errors = [];
+  let canceled = false;
+  const progress = (detail) => handlers.onProgress?.({ total: jobs.length, exported: records.length, failed: errors.length, ...detail });
+
+  for (let index = 0; index < jobs.length; index += 1) {
+    if (handlers.shouldCancel?.()) {
+      canceled = true;
+      progress({ status: 'canceled', index, name: jobs[index]?.result?.name || '' });
+      break;
+    }
+    const job = jobs[index];
+    progress({ status: 'processing', index, name: job?.result?.name || '' });
+    try {
+      const record = await renderJob(job, directory, handlers, reserved);
+      records.push(record);
+      progress({ status: 'done', index, name: record.sourceName, outputName: path.basename(record.outputPath) });
+    } catch (error) {
+      const failure = { id: job?.id, sourceName: job?.result?.name || '', error: String(error?.message || error) };
+      errors.push(failure);
+      progress({ status: 'failed', index, name: failure.sourceName, error: failure.error });
+    }
+  }
+
+  const manifestPath = await availablePath(directory, '墨隐-批处理清单.json', reserved);
+  const manifest = {
+    format: MANIFEST_FORMAT,
+    version: 1,
+    exportedAt: new Date().toISOString(),
+    canceled,
+    total: jobs.length,
+    exported: records.length,
+    failed: errors.length,
+    items: records.map((record) => ({
+      sourceName: record.sourceName,
+      outputName: path.basename(record.outputPath),
+      auditName: path.basename(record.auditPath),
+      findingCount: record.findingCount,
+      render: record.render
+    })),
+    errors
+  };
+  await fs.writeFile(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, { encoding: 'utf8', flag: 'wx' });
+  progress({ status: canceled ? 'canceled' : 'complete', index: records.length + errors.length, manifestName: path.basename(manifestPath) });
+  return { directory, canceled, total: jobs.length, exported: records.length, failed: errors.length, records, errors, manifestPath };
+}
+
+module.exports = {
+  AUDIT_FORMAT,
+  MANIFEST_FORMAT,
+  outputFileName,
+  exportBatchResults
+};
diff --git a/moyin/src/services/batch-vault-service.cjs b/moyin/src/services/batch-vault-service.cjs
new file mode 100644
index 0000000..481a836
--- /dev/null
+++ b/moyin/src/services/batch-vault-service.cjs
@@ -0,0 +1,40 @@
+'use strict';
+
+const VEILFORGE_BATCH_VAULT_V1 = 'VEILFORGE_BATCH_VAULT_V1';
+
+async function saveBatchRecordsToVault(records, addEntry) {
+  if (!Array.isArray(records)) throw new Error('LOCAL_BATCH_VAULT_RECORDS_INVALID');
+  if (typeof addEntry !== 'function') throw new Error('LOCAL_BATCH_VAULT_WRITER_INVALID');
+  const result = { requested: records.length, saved: 0, failed: 0, entries: [], errors: [], attachmentFiles: 0 };
+  for (const record of records) {
+    const text = String(record?.vaultText || '');
+    if (!text) {
+      result.failed += 1;
+      result.errors.push({ id: String(record?.id || ''), sourceName: String(record?.sourceName || ''), error: 'LOCAL_BATCH_VAULT_TEXT_EMPTY' });
+      continue;
+    }
+    const payload = {
+      kind: 'redacted-text',
+      name: `${String(record?.sourceName || '批处理结果').slice(0, 200)} · 批量脱敏`,
+      text,
+      findingCount: Math.max(0, Number(record?.findingCount || 0)),
+      findingTypes: Array.isArray(record?.findingTypes) ? record.findingTypes.map(String) : []
+    };
+    try {
+      const saved = await addEntry(payload, record);
+      result.entries.push(saved);
+      result.attachmentFiles += Number(saved?.attachmentResult?.files || 0);
+      result.saved += 1;
+    } catch (error) {
+      result.failed += 1;
+      result.errors.push({
+        id: String(record?.id || ''),
+        sourceName: String(record?.sourceName || ''),
+        error: String(error?.message || error)
+      });
+    }
+  }
+  return result;
+}
+
+module.exports = { VEILFORGE_BATCH_VAULT_V1, saveBatchRecordsToVault };
diff --git a/moyin/src/services/csv-redaction-service.cjs b/moyin/src/services/csv-redaction-service.cjs
new file mode 100644
index 0000000..a5ffb99
--- /dev/null
+++ b/moyin/src/services/csv-redaction-service.cjs
@@ -0,0 +1,235 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const iconv = require('iconv-lite');
+
+const MAX_CSV_BYTES = 100 * 1024 * 1024;
+const DELIMITERS = [',', ';', '\t', '|'];
+
+function detectEncoding(bytes) {
+  if (bytes.length >= 3 && bytes[0] === 0xef && bytes[1] === 0xbb && bytes[2] === 0xbf) {
+    return { encoding: 'utf8', bom: Buffer.from([0xef, 0xbb, 0xbf]), offset: 3 };
+  }
+  if (bytes.length >= 2 && bytes[0] === 0xff && bytes[1] === 0xfe) {
+    return { encoding: 'utf16le', bom: Buffer.from([0xff, 0xfe]), offset: 2 };
+  }
+  if (bytes.length >= 2 && bytes[0] === 0xfe && bytes[1] === 0xff) {
+    return { encoding: 'utf16-be', bom: Buffer.from([0xfe, 0xff]), offset: 2 };
+  }
+  const utf8 = bytes.toString('utf8');
+  const replacementRatio = (utf8.match(/\uFFFD/gu) || []).length / Math.max(1, utf8.length);
+  return { encoding: replacementRatio < 0.002 ? 'utf8' : 'gb18030', bom: Buffer.alloc(0), offset: 0 };
+}
+
+function decodeCsvBuffer(bytes) {
+  const buffer = Buffer.isBuffer(bytes) ? bytes : Buffer.from(bytes || []);
+  const detected = detectEncoding(buffer);
+  const payload = buffer.subarray(detected.offset);
+  const text = detected.encoding === 'utf8' ? payload.toString('utf8') : iconv.decode(payload, detected.encoding);
+  return { text, encoding: detected.encoding, bom: detected.bom };
+}
+
+function lineEndingOf(text) {
+  const crlf = (text.match(/\r\n/gu) || []).length;
+  const lf = (text.match(/(?<!\r)\n/gu) || []).length;
+  const cr = (text.match(/\r(?!\n)/gu) || []).length;
+  if (crlf >= lf && crlf >= cr && crlf > 0) return '\r\n';
+  if (lf >= cr && lf > 0) return '\n';
+  if (cr > 0) return '\r';
+  return '';
+}
+
+function scanCsvFields(text, delimiter, quote = '"') {
+  const source = String(text || '');
+  const rows = [];
+  let row = [];
+  let fieldStart = 0;
+  let inQuotes = false;
+  let index = 0;
+  const pushField = (end) => row.push({ start: fieldStart, end, raw: source.slice(fieldStart, end) });
+  const pushRow = () => {
+    rows.push(row);
+    row = [];
+  };
+
+  while (index < source.length) {
+    const character = source[index];
+    if (character === quote) {
+      if (inQuotes && source[index + 1] === quote) index += 1;
+      else inQuotes = !inQuotes;
+    } else if (!inQuotes && character === delimiter) {
+      pushField(index);
+      fieldStart = index + 1;
+    } else if (!inQuotes && (character === '\r' || character === '\n')) {
+      pushField(index);
+      pushRow();
+      if (character === '\r' && source[index + 1] === '\n') index += 1;
+      fieldStart = index + 1;
+    }
+    index += 1;
+  }
+  if (fieldStart < source.length || row.length || (!rows.length && source.length)) {
+    pushField(source.length);
+    pushRow();
+  }
+  return rows;
+}
+
+function meaningfulCounts(rows) {
+  return rows
+    .filter((row) => row.some((field) => field.raw.length > 0))
+    .map((row) => row.length);
+}
+
+function detectDelimiter(text) {
+  let best = { delimiter: ',', score: -1 };
+  for (const delimiter of DELIMITERS) {
+    const counts = meaningfulCounts(scanCsvFields(text, delimiter)).slice(0, 40);
+    const frequencies = new Map();
+    for (const count of counts) frequencies.set(count, (frequencies.get(count) || 0) + 1);
+    const [mode = 1, frequency = 0] = [...frequencies].sort((a, b) => b[1] - a[1] || b[0] - a[0])[0] || [];
+    const score = mode > 1 ? frequency * 1000 + mode * 10 + counts.length : counts.length;
+    if (score > best.score) best = { delimiter, score };
+  }
+  return best.delimiter;
+}
+
+function formulaOffset(raw, quote = '"') {
+  let offset = raw.startsWith(quote) ? 1 : 0;
+  while (raw[offset] === ' ' || raw[offset] === '\t') offset += 1;
+  const marker = raw[offset];
+  const next = raw[offset + 1] || '';
+  if (marker === '=' || marker === '@') return offset;
+  if ((marker === '+' || marker === '-') && !/[0-9.]/u.test(next)) return offset;
+  return -1;
+}
+
+function inspectCsvText(text, delimiter = detectDelimiter(text)) {
+  const rows = scanCsvFields(text, delimiter);
+  const rowFieldCounts = meaningfulCounts(rows);
+  let formulaCells = 0;
+  for (const row of rows) {
+    for (const field of row) if (formulaOffset(field.raw) >= 0) formulaCells += 1;
+  }
+  return {
+    delimiter,
+    lineEnding: lineEndingOf(text),
+    rows: rowFieldCounts.length,
+    columns: rowFieldCounts.length ? Math.max(...rowFieldCounts) : 0,
+    rowFieldCounts,
+    formulaCells
+  };
+}
+
+function sanitizeFormulaCells(text, delimiter) {
+  const rows = scanCsvFields(text, delimiter);
+  const inserts = [];
+  for (const row of rows) {
+    for (const field of row) {
+      const offset = formulaOffset(field.raw);
+      if (offset >= 0) inserts.push(field.start + offset);
+    }
+  }
+  let output = String(text || '');
+  for (const index of inserts.sort((left, right) => right - left)) {
+    output = `${output.slice(0, index)}'${output.slice(index)}`;
+  }
+  return { text: output, escaped: inserts.length };
+}
+
+function delimiterName(delimiter) {
+  return delimiter === '\t' ? 'TAB' : delimiter === ';' ? '分号' : delimiter === '|' ? '竖线' : '逗号';
+}
+
+function lineEndingName(lineEnding) {
+  return lineEnding === '\r\n' ? 'CRLF' : lineEnding === '\r' ? 'CR' : lineEnding === '\n' ? 'LF' : 'NONE';
+}
+
+function sameStructure(left, right) {
+  return left.delimiter === right.delimiter && left.lineEnding === right.lineEnding && left.rowFieldCounts.length === right.rowFieldCounts.length &&
+    left.rowFieldCounts.every((count, index) => count === right.rowFieldCounts[index]);
+}
+
+function encodeCsvText(text, session) {
+  const payload = session.encoding === 'utf8' ? Buffer.from(text, 'utf8') : iconv.encode(text, session.encoding);
+  return session.bom?.length ? Buffer.concat([session.bom, payload]) : payload;
+}
+
+async function extractCsvDocument(filePath) {
+  if (typeof filePath !== 'string' || !path.isAbsolute(filePath)) throw new Error('LOCAL_CSV_PATH_INVALID');
+  const stat = await fs.stat(filePath);
+  if (!stat.isFile()) throw new Error('LOCAL_CSV_NOT_A_FILE');
+  if (stat.size > MAX_CSV_BYTES) throw new Error('LOCAL_CSV_TOO_LARGE');
+  const bytes = await fs.readFile(filePath);
+  const decoded = decodeCsvBuffer(bytes);
+  if (!decoded.text.trim()) throw new Error('LOCAL_CSV_EMPTY');
+  const inspection = inspectCsvText(decoded.text);
+  const session = {
+    kind: 'csv',
+    sourceName: path.basename(filePath),
+    sourcePath: path.resolve(filePath),
+    sourceBytes: stat.size,
+    encoding: decoded.encoding,
+    bom: decoded.bom,
+    delimiter: inspection.delimiter,
+    lineEnding: inspection.lineEnding,
+    inspection
+  };
+  return {
+    name: session.sourceName,
+    extension: '.csv',
+    sourceBytes: stat.size,
+    characters: decoded.text.length,
+    text: decoded.text,
+    session,
+    metadata: {
+      encoding: session.encoding,
+      bom: session.bom.length > 0,
+      delimiter: session.delimiter,
+      delimiterName: delimiterName(session.delimiter),
+      lineEnding: session.lineEnding,
+      lineEndingName: lineEndingName(session.lineEnding),
+      rows: inspection.rows,
+      columns: inspection.columns,
+      formulaCells: inspection.formulaCells
+    }
+  };
+}
+
+async function renderRedactedCsv(session, text, outputPath, options = {}) {
+  if (!session || session.kind !== 'csv') throw new Error('LOCAL_CSV_SESSION_INVALID');
+  if (typeof text !== 'string') throw new Error('LOCAL_CSV_TEXT_INVALID');
+  const inspection = inspectCsvText(text, session.delimiter);
+  if (!sameStructure(session.inspection, inspection)) throw new Error('LOCAL_CSV_STRUCTURE_CHANGED');
+  const protectedOutput = options.sanitizeFormulas === false
+    ? { text, escaped: 0 }
+    : sanitizeFormulaCells(text, session.delimiter);
+  const bytes = encodeCsvText(protectedOutput.text, session);
+  if (bytes.length > MAX_CSV_BYTES) throw new Error('LOCAL_CSV_TOO_LARGE');
+  await fs.writeFile(outputPath, bytes, { flag: 'wx', mode: 0o600 });
+  return {
+    bytes: bytes.length,
+    characters: protectedOutput.text.length,
+    encoding: session.encoding,
+    bomPreserved: session.bom.length > 0,
+    delimiter: session.delimiter,
+    delimiterName: delimiterName(session.delimiter),
+    lineEnding: session.lineEnding,
+    lineEndingName: lineEndingName(session.lineEnding),
+    rows: inspection.rows,
+    columns: inspection.columns,
+    formulaCellsEscaped: protectedOutput.escaped,
+    originalFormatPreserved: true
+  };
+}
+
+module.exports = {
+  MAX_CSV_BYTES,
+  decodeCsvBuffer,
+  detectDelimiter,
+  inspectCsvText,
+  sanitizeFormulaCells,
+  extractCsvDocument,
+  renderRedactedCsv
+};
diff --git a/moyin/src/services/document-extractor.cjs b/moyin/src/services/document-extractor.cjs
new file mode 100644
index 0000000..43ce172
--- /dev/null
+++ b/moyin/src/services/document-extractor.cjs
@@ -0,0 +1,85 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const iconv = require('iconv-lite');
+const mammoth = require('mammoth');
+const XLSX = require('xlsx');
+
+const MAX_INPUT_BYTES = 100 * 1024 * 1024;
+const SUPPORTED_EXTENSIONS = ['.txt', '.md', '.csv', '.json', '.log', '.pdf', '.docx', '.xlsx', '.xls'];
+
+function normalizeText(value) {
+  return String(value || '')
+    .replace(/\u0000/g, '')
+    .replace(/\r\n?/g, '\n')
+    .replace(/[ \t]+\n/g, '\n')
+    .trim();
+}
+
+function decodeText(bytes) {
+  const utf8 = bytes.toString('utf8');
+  const replacementRatio = (utf8.match(/\uFFFD/g) || []).length / Math.max(1, utf8.length);
+  return replacementRatio < 0.002 ? utf8 : iconv.decode(bytes, 'gb18030');
+}
+
+async function extractPdf(bytes) {
+  const pdfjs = await import('pdfjs-dist/legacy/build/pdf.mjs');
+  const task = pdfjs.getDocument({
+    data: new Uint8Array(bytes),
+    disableFontFace: true,
+    useSystemFonts: false,
+    isEvalSupported: false
+  });
+  const pdf = await task.promise;
+  const pages = [];
+  for (let number = 1; number <= pdf.numPages; number += 1) {
+    const page = await pdf.getPage(number);
+    const content = await page.getTextContent();
+    pages.push(content.items.map((item) => item.str || '').join(' '));
+    page.cleanup();
+  }
+  await pdf.destroy();
+  return pages.join('\n\n');
+}
+
+function extractWorkbook(bytes) {
+  const workbook = XLSX.read(bytes, { type: 'buffer', cellDates: false, cellNF: false, cellStyles: false });
+  return workbook.SheetNames.map((name) => {
+    const csv = XLSX.utils.sheet_to_csv(workbook.Sheets[name], { FS: '\t', blankrows: false });
+    return `【工作表：${name}】\n${csv}`;
+  }).join('\n\n');
+}
+
+async function extractDocument(filePath) {
+  if (typeof filePath !== 'string' || !path.isAbsolute(filePath)) throw new Error('LOCAL_PATH_INVALID');
+  const extension = path.extname(filePath).toLowerCase();
+  if (!SUPPORTED_EXTENSIONS.includes(extension)) throw new Error('LOCAL_TYPE_UNSUPPORTED');
+  const stat = await fs.stat(filePath);
+  if (!stat.isFile()) throw new Error('LOCAL_NOT_A_FILE');
+  if (stat.size > MAX_INPUT_BYTES) throw new Error('LOCAL_FILE_TOO_LARGE');
+  const bytes = await fs.readFile(filePath);
+
+  let text;
+  if (['.txt', '.md', '.csv', '.json', '.log'].includes(extension)) {
+    text = decodeText(bytes);
+  } else if (extension === '.docx') {
+    text = (await mammoth.extractRawText({ buffer: bytes })).value;
+  } else if (extension === '.pdf') {
+    text = await extractPdf(bytes);
+  } else {
+    text = extractWorkbook(bytes);
+  }
+
+  text = normalizeText(text);
+  if (!text) throw new Error('LOCAL_DOCUMENT_EMPTY');
+  return {
+    name: path.basename(filePath),
+    extension,
+    sourceBytes: stat.size,
+    characters: text.length,
+    text
+  };
+}
+
+module.exports = { extractDocument, normalizeText, SUPPORTED_EXTENSIONS, MAX_INPUT_BYTES };
diff --git a/moyin/src/services/job-workspace-service.cjs b/moyin/src/services/job-workspace-service.cjs
new file mode 100644
index 0000000..8fab494
--- /dev/null
+++ b/moyin/src/services/job-workspace-service.cjs
@@ -0,0 +1,230 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { createReadStream, createWriteStream } = require('node:fs');
+const { Transform } = require('node:stream');
+const { pipeline } = require('node:stream/promises');
+const { createHash, randomUUID } = require('node:crypto');
+const { createResourceBudget, assertNotAborted } = require('./resource-budget-service.cjs');
+
+const WORKSPACE_PREFIX = 'veilforge-job-';
+const MANIFEST_NAME = 'job-manifest.json';
+const JOB_ID_PATTERN = /^[A-Za-z0-9-]{8,80}$/u;
+
+function resolveAbsolute(value, code = 'LOCAL_WORKSPACE_PATH_INVALID') {
+  if (typeof value !== 'string' || !path.isAbsolute(value)) throw new Error(code);
+  return path.resolve(value);
+}
+
+function safeJobId(value = randomUUID()) {
+  const normalized = String(value || '');
+  if (!JOB_ID_PATTERN.test(normalized)) throw new Error('LOCAL_WORKSPACE_JOB_ID_INVALID');
+  return normalized;
+}
+
+function assertChildPath(root, candidate) {
+  const resolvedRoot = path.resolve(root);
+  const resolvedCandidate = path.resolve(candidate);
+  const relative = path.relative(resolvedRoot, resolvedCandidate);
+  if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) throw new Error('LOCAL_WORKSPACE_PATH_INVALID');
+  return resolvedCandidate;
+}
+
+async function atomicJson(filePath, value) {
+  const temporary = `${filePath}.${randomUUID()}.tmp`;
+  await fs.writeFile(temporary, `${JSON.stringify(value, null, 2)}\n`, { encoding: 'utf8', mode: 0o600, flag: 'wx' });
+  await fs.rename(temporary, filePath);
+}
+
+async function removeWorkspaceDirectory(root, directory) {
+  const resolvedRoot = resolveAbsolute(root);
+  const resolvedDirectory = assertChildPath(resolvedRoot, directory);
+  if (path.dirname(resolvedDirectory) !== resolvedRoot || !path.basename(resolvedDirectory).startsWith(WORKSPACE_PREFIX)) {
+    throw new Error('LOCAL_WORKSPACE_DELETE_DENIED');
+  }
+  await fs.rm(resolvedDirectory, { recursive: true, force: true });
+}
+
+async function copyAndHash(source, destination, options = {}) {
+  const hash = createHash('sha256');
+  let bytes = 0;
+  const meter = new Transform({
+    transform(chunk, _encoding, callback) {
+      try {
+        assertNotAborted(options.signal);
+        hash.update(chunk);
+        bytes += chunk.length;
+        options.onProgress?.({ stage: 'copy-input', bytes, totalBytes: options.totalBytes || 0 });
+        callback(null, chunk);
+      } catch (error) {
+        callback(error);
+      }
+    }
+  });
+  assertNotAborted(options.signal);
+  await pipeline(
+    createReadStream(source),
+    meter,
+    createWriteStream(destination, { flags: 'wx', mode: 0o600 }),
+    { signal: options.signal }
+  );
+  return { bytes, sha256: hash.digest('hex') };
+}
+
+function isProcessRunning(pid) {
+  if (!Number.isSafeInteger(pid) || pid < 1) return false;
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return error?.code === 'EPERM';
+  }
+}
+
+async function recoverOrphanedWorkspaces(root, options = {}) {
+  const resolvedRoot = resolveAbsolute(root);
+  await fs.mkdir(resolvedRoot, { recursive: true, mode: 0o700 });
+  const entries = await fs.readdir(resolvedRoot, { withFileTypes: true });
+  const report = { scanned: 0, removed: 0, active: 0, errors: [] };
+  for (const entry of entries) {
+    if (!entry.isDirectory() || !entry.name.startsWith(WORKSPACE_PREFIX)) continue;
+    report.scanned += 1;
+    const directory = assertChildPath(resolvedRoot, path.join(resolvedRoot, entry.name));
+    let manifest = null;
+    try {
+      manifest = JSON.parse(await fs.readFile(path.join(directory, MANIFEST_NAME), 'utf8'));
+    } catch (error) {
+      report.errors.push({ directory: entry.name, code: error?.code || 'INVALID_MANIFEST' });
+    }
+    if (manifest?.pid === process.pid || isProcessRunning(Number(manifest?.pid))) {
+      report.active += 1;
+      continue;
+    }
+    try {
+      await removeWorkspaceDirectory(resolvedRoot, directory);
+      report.removed += 1;
+    } catch (error) {
+      report.errors.push({ directory: entry.name, code: error?.code || error?.message || 'REMOVE_FAILED' });
+    }
+  }
+  return report;
+}
+
+async function createJobWorkspace(inputPath, options = {}) {
+  const sourcePath = resolveAbsolute(inputPath, 'LOCAL_PATH_INVALID');
+  const root = resolveAbsolute(options.root, 'LOCAL_WORKSPACE_ROOT_INVALID');
+  const jobId = safeJobId(options.jobId);
+  const budget = options.budget || createResourceBudget({ profile: options.profile || 'parity' });
+  const sourceStat = await fs.stat(sourcePath);
+  if (!sourceStat.isFile()) throw new Error('LOCAL_NOT_A_FILE');
+  budget.assertInputBytes(sourceStat.size);
+  assertNotAborted(options.signal);
+  await fs.mkdir(root, { recursive: true, mode: 0o700 });
+  await budget.assertDiskSpace(root, Math.min(budget.profile.maxWorkspaceBytes, sourceStat.size * 3 + 64 * 1024 * 1024));
+  const directory = assertChildPath(root, path.join(root, `${WORKSPACE_PREFIX}${jobId}`));
+  await fs.mkdir(directory, { recursive: false, mode: 0o700 });
+  const inputDirectory = path.join(directory, 'input');
+  const pageDirectory = path.join(directory, 'pages');
+  const outputDirectory = path.join(directory, 'output');
+  await Promise.all([
+    fs.mkdir(inputDirectory, { mode: 0o700 }),
+    fs.mkdir(pageDirectory, { mode: 0o700 }),
+    fs.mkdir(outputDirectory, { mode: 0o700 })
+  ]);
+  const extension = path.extname(sourcePath).toLowerCase();
+  const stagedName = `source${extension || '.bin'}`;
+  const stagedInputPath = path.join(inputDirectory, stagedName);
+  const manifestPath = path.join(directory, MANIFEST_NAME);
+  const manifest = {
+    format: 'VEILFORGE_JOB_WORKSPACE',
+    version: 1,
+    jobId,
+    pid: process.pid,
+    state: 'staging',
+    createdAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+    sourceName: path.basename(sourcePath),
+    sourceBytes: sourceStat.size,
+    sourceSha256: '',
+    stagedName,
+    profile: budget.profile.name,
+    stages: []
+  };
+  await atomicJson(manifestPath, manifest);
+  try {
+    const copied = await copyAndHash(sourcePath, stagedInputPath, {
+      signal: options.signal,
+      onProgress: options.onProgress,
+      totalBytes: sourceStat.size
+    });
+    if (copied.bytes !== sourceStat.size) throw new Error('LOCAL_WORKSPACE_COPY_INCOMPLETE');
+    manifest.state = 'active';
+    manifest.sourceSha256 = copied.sha256;
+    manifest.updatedAt = new Date().toISOString();
+    manifest.stages.push({ name: 'staged', at: manifest.updatedAt, bytes: copied.bytes });
+    await atomicJson(manifestPath, manifest);
+  } catch (error) {
+    await removeWorkspaceDirectory(root, directory).catch(() => {});
+    if (error?.name === 'AbortError' || options.signal?.aborted) throw new Error('LOCAL_JOB_ABORTED', { cause: error });
+    throw error;
+  }
+
+  let closed = false;
+  const workspace = {
+    jobId,
+    root,
+    directory,
+    inputPath: stagedInputPath,
+    pageDirectory,
+    outputDirectory,
+    manifestPath,
+    sourceName: manifest.sourceName,
+    sourceBytes: manifest.sourceBytes,
+    sourceSha256: manifest.sourceSha256,
+    budget,
+    createPath(relativePath) {
+      if (closed) throw new Error('LOCAL_WORKSPACE_CLOSED');
+      if (typeof relativePath !== 'string' || !relativePath || path.isAbsolute(relativePath)) throw new Error('LOCAL_WORKSPACE_PATH_INVALID');
+      return assertChildPath(directory, path.join(directory, relativePath));
+    },
+    async recordStage(name, detail = {}) {
+      if (closed) throw new Error('LOCAL_WORKSPACE_CLOSED');
+      manifest.updatedAt = new Date().toISOString();
+      manifest.stages.push({ name: String(name), at: manifest.updatedAt, ...detail });
+      await atomicJson(manifestPath, manifest);
+    },
+    async measure() {
+      let total = 0;
+      const queue = [directory];
+      while (queue.length) {
+        const current = queue.pop();
+        for (const entry of await fs.readdir(current, { withFileTypes: true })) {
+          const fullPath = path.join(current, entry.name);
+          if (entry.isDirectory()) queue.push(fullPath);
+          else if (entry.isFile()) total += (await fs.stat(fullPath)).size;
+        }
+      }
+      budget.assertWorkspaceBytes(total);
+      return total;
+    },
+    async cleanup() {
+      if (closed) return false;
+      closed = true;
+      await removeWorkspaceDirectory(root, directory);
+      return true;
+    }
+  };
+  return Object.freeze(workspace);
+}
+
+module.exports = {
+  WORKSPACE_PREFIX,
+  MANIFEST_NAME,
+  createJobWorkspace,
+  recoverOrphanedWorkspaces,
+  removeWorkspaceDirectory,
+  copyAndHash,
+  isProcessRunning,
+  assertChildPath
+};
diff --git a/moyin/src/services/model-pack-service.cjs b/moyin/src/services/model-pack-service.cjs
new file mode 100644
index 0000000..edaf2c3
--- /dev/null
+++ b/moyin/src/services/model-pack-service.cjs
@@ -0,0 +1,128 @@
+'use strict';
+
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+
+const MODEL_PACK_FORMAT = 'VEILFORGE_MODEL_PACK_V1';
+const MANIFEST_FILE = 'manifest.json';
+const MAX_MANIFEST_BYTES = 256 * 1024;
+const MAX_PACK_FILES = 32;
+const MAX_MODEL_FILE_BYTES = 1024 * 1024 * 1024;
+
+function sha256File(filePath) {
+  return new Promise((resolve, reject) => {
+    const hash = createHash('sha256');
+    const stream = fs.createReadStream(filePath);
+    stream.on('error', reject);
+    stream.on('data', (chunk) => hash.update(chunk));
+    stream.on('end', () => resolve(hash.digest('hex')));
+  });
+}
+
+function safeRelative(value) {
+  const normalized = String(value || '').replace(/\\/gu, '/');
+  if (!normalized || path.isAbsolute(normalized) || normalized.startsWith('/') || normalized.split('/').includes('..')) {
+    throw new Error('LOCAL_MODEL_PACK_PATH_INVALID');
+  }
+  return normalized;
+}
+
+function validateManifest(manifest, expectedKind) {
+  if (!manifest || manifest.format !== MODEL_PACK_FORMAT || !/^[a-z0-9][a-z0-9._-]{2,63}$/u.test(String(manifest.id || ''))) {
+    throw new Error('LOCAL_MODEL_PACK_MANIFEST_INVALID');
+  }
+  if (!['ner', 'ocr'].includes(manifest.kind) || (expectedKind && manifest.kind !== expectedKind)) {
+    throw new Error('LOCAL_MODEL_PACK_KIND_INVALID');
+  }
+  if (!Array.isArray(manifest.files) || manifest.files.length < 3 || manifest.files.length > MAX_PACK_FILES) {
+    throw new Error('LOCAL_MODEL_PACK_MANIFEST_INVALID');
+  }
+  const seen = new Set();
+  for (const item of manifest.files) {
+    item.path = safeRelative(item.path);
+    if (seen.has(item.path) || !Number.isInteger(item.bytes) || item.bytes < 1 || item.bytes > MAX_MODEL_FILE_BYTES ||
+        !/^[a-f0-9]{64}$/u.test(String(item.sha256 || ''))) {
+      throw new Error('LOCAL_MODEL_PACK_MANIFEST_INVALID');
+    }
+    seen.add(item.path);
+  }
+  if (!seen.has(safeRelative(manifest.entry)) || !seen.has('LICENSE.txt') || !seen.has('NOTICE.txt')) {
+    throw new Error('LOCAL_MODEL_PACK_MANIFEST_INVALID');
+  }
+  return manifest;
+}
+
+async function inspectModelPack(directory, expectedKind = null) {
+  if (typeof directory !== 'string' || !path.isAbsolute(directory)) throw new Error('LOCAL_MODEL_PACK_DIRECTORY_INVALID');
+  const resolved = path.resolve(directory);
+  const manifestPath = path.join(resolved, MANIFEST_FILE);
+  const manifestStat = await fsp.stat(manifestPath).catch(() => null);
+  if (!manifestStat?.isFile() || manifestStat.size < 2 || manifestStat.size > MAX_MANIFEST_BYTES) {
+    throw new Error('LOCAL_MODEL_PACK_MANIFEST_MISSING');
+  }
+  let manifest;
+  try { manifest = validateManifest(JSON.parse(await fsp.readFile(manifestPath, 'utf8')), expectedKind); }
+  catch (error) {
+    if (String(error?.message || '').startsWith('LOCAL_MODEL_PACK_')) throw error;
+    throw new Error('LOCAL_MODEL_PACK_MANIFEST_INVALID');
+  }
+  const files = [];
+  for (const item of manifest.files) {
+    const filePath = path.resolve(resolved, item.path);
+    if (!filePath.startsWith(`${resolved}${path.sep}`)) throw new Error('LOCAL_MODEL_PACK_PATH_INVALID');
+    const stat = await fsp.stat(filePath).catch(() => null);
+    if (!stat?.isFile() || stat.size !== item.bytes) throw new Error(`LOCAL_MODEL_PACK_SIZE_MISMATCH:${item.path}`);
+    const sha256 = await sha256File(filePath);
+    if (sha256 !== item.sha256) throw new Error(`LOCAL_MODEL_PACK_HASH_MISMATCH:${item.path}`);
+    files.push({ ...item, filePath, sha256 });
+  }
+  const manifestSha256 = await sha256File(manifestPath);
+  return {
+    directory: resolved,
+    manifestPath,
+    manifestSha256,
+    id: manifest.id,
+    kind: manifest.kind,
+    name: String(manifest.name || manifest.id),
+    version: String(manifest.version || ''),
+    engine: String(manifest.engine || ''),
+    source: String(manifest.source || ''),
+    license: String(manifest.license || ''),
+    entry: path.join(resolved, safeRelative(manifest.entry)),
+    files,
+    bytes: files.reduce((sum, item) => sum + item.bytes, 0),
+    manifest
+  };
+}
+
+function modelPackRoot() {
+  if (process.env.VEILFORGE_MODEL_PACK_ROOT) return path.resolve(process.env.VEILFORGE_MODEL_PACK_ROOT);
+  if (process.resourcesPath && !process.defaultApp) return path.join(process.resourcesPath, 'model-packs');
+  return path.resolve(__dirname, '../../model-packs');
+}
+
+async function findModelPacks(expectedKind = null, root = modelPackRoot()) {
+  const entries = await fsp.readdir(root, { withFileTypes: true }).catch(() => []);
+  const results = [];
+  for (const entry of entries.filter((item) => item.isDirectory()).sort((a, b) => a.name.localeCompare(b.name))) {
+    try { results.push(await inspectModelPack(path.join(root, entry.name), expectedKind)); }
+    catch (error) { results.push({ directory: path.join(root, entry.name), valid: false, error: String(error?.message || error) }); }
+  }
+  return results;
+}
+
+async function findFirstModelPack(kind, root = modelPackRoot()) {
+  const packs = await findModelPacks(kind, root);
+  return packs.find((item) => item.kind === kind) || null;
+}
+
+module.exports = {
+  MODEL_PACK_FORMAT,
+  inspectModelPack,
+  findModelPacks,
+  findFirstModelPack,
+  modelPackRoot,
+  sha256File
+};
diff --git a/moyin/src/services/ner-service.cjs b/moyin/src/services/ner-service.cjs
new file mode 100644
index 0000000..c3ea9ed
--- /dev/null
+++ b/moyin/src/services/ner-service.cjs
@@ -0,0 +1,331 @@
+'use strict';
+
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const ort = require('onnxruntime-node');
+const { inspectModelPack } = require('./model-pack-service.cjs');
+
+const MODEL_FILE = 'model.onnx';
+const VOCAB_FILE = 'vocab.txt';
+const CONFIG_FILE = 'config.json';
+const MAX_MODEL_BYTES = 1024 * 1024 * 1024;
+const MAX_VOCAB_BYTES = 8 * 1024 * 1024;
+const MAX_CONFIG_BYTES = 1024 * 1024;
+const DEFAULT_ACCEPT_THRESHOLD = 0.78;
+const DEFAULT_REVIEW_THRESHOLD = 0.52;
+const DEFAULT_WINDOW_TOKENS = 126;
+const DEFAULT_OVERLAP = 32;
+const ENTITY_TYPES = Object.freeze({ ORG: 'company', PER: 'person', LOC: 'address' });
+
+function assertModelDirectory(directory) {
+  if (typeof directory !== 'string' || !path.isAbsolute(directory)) throw new Error('LOCAL_NER_PATH_INVALID');
+}
+
+async function fileInfo(filePath, maximum) {
+  const stat = await fsp.stat(filePath).catch(() => null);
+  if (!stat?.isFile() || stat.size < 1 || stat.size > maximum) throw new Error('LOCAL_NER_MODEL_INVALID');
+  return { path: filePath, bytes: stat.size };
+}
+
+async function sha256File(filePath) {
+  return new Promise((resolve, reject) => {
+    const hash = createHash('sha256');
+    const stream = fs.createReadStream(filePath);
+    stream.on('error', reject);
+    stream.on('data', (chunk) => hash.update(chunk));
+    stream.on('end', () => resolve(hash.digest('hex')));
+  });
+}
+
+function labelMap(config) {
+  const entries = Object.entries(config?.id2label || {});
+  if (!entries.length) throw new Error('LOCAL_NER_CONFIG_INVALID');
+  const labels = new Map();
+  for (const [id, label] of entries) {
+    const numeric = Number(id);
+    if (!Number.isInteger(numeric) || typeof label !== 'string' || !/^(?:[BI]-(?:ORG|PER|LOC|TIME)|O)$/u.test(label)) {
+      throw new Error('LOCAL_NER_CONFIG_INVALID');
+    }
+    labels.set(numeric, label);
+  }
+  return labels;
+}
+
+async function inspectNerModelDirectory(directory) {
+  assertModelDirectory(directory);
+  const resolved = path.resolve(directory);
+  const hasManifest = (await fsp.stat(path.join(resolved, 'manifest.json')).catch(() => null))?.isFile() === true;
+  const modelPack = hasManifest ? await inspectModelPack(resolved, 'ner') : null;
+  const model = await fileInfo(path.join(resolved, MODEL_FILE), MAX_MODEL_BYTES);
+  const vocab = await fileInfo(path.join(resolved, VOCAB_FILE), MAX_VOCAB_BYTES);
+  const configFile = await fileInfo(path.join(resolved, CONFIG_FILE), MAX_CONFIG_BYTES);
+  let config;
+  try {
+    config = JSON.parse(await fsp.readFile(configFile.path, 'utf8'));
+  } catch {
+    throw new Error('LOCAL_NER_CONFIG_INVALID');
+  }
+  if (config.model_type !== 'bert' || !Number.isInteger(config.vocab_size) || config.vocab_size < 100 ||
+      !Number.isInteger(config.max_position_embeddings) || config.max_position_embeddings < 16) {
+    throw new Error('LOCAL_NER_CONFIG_INVALID');
+  }
+  const labels = labelMap(config);
+  const [modelSha256, vocabSha256, configSha256] = await Promise.all([
+    sha256File(model.path), sha256File(vocab.path), sha256File(configFile.path)
+  ]);
+  return {
+    directory: resolved,
+    name: path.basename(resolved),
+    model,
+    vocab,
+    configFile,
+    config,
+    labels,
+    modelSha256,
+    vocabSha256,
+    configSha256,
+    modelPack
+  };
+}
+
+function isCjk(codePoint) {
+  return (codePoint >= 0x3400 && codePoint <= 0x4dbf) || (codePoint >= 0x4e00 && codePoint <= 0x9fff) ||
+    (codePoint >= 0xf900 && codePoint <= 0xfaff) || (codePoint >= 0x20000 && codePoint <= 0x3134f);
+}
+
+function isPunctuation(character) {
+  return /[\p{P}\p{S}]/u.test(character);
+}
+
+class BertTokenizer {
+  constructor(vocabText) {
+    const words = String(vocabText || '').split(/\r?\n/u).filter((value) => value.length > 0);
+    this.vocab = new Map(words.map((word, index) => [word, index]));
+    this.unknown = this.required('[UNK]');
+    this.cls = this.required('[CLS]');
+    this.sep = this.required('[SEP]');
+  }
+
+  required(token) {
+    const id = this.vocab.get(token);
+    if (!Number.isInteger(id)) throw new Error('LOCAL_NER_VOCAB_INVALID');
+    return id;
+  }
+
+  wordPieces(word, start) {
+    const normalized = word.toLocaleLowerCase('zh-CN');
+    if (normalized.length > 100) return [{ id: this.unknown, start, end: start + word.length }];
+    const pieces = [];
+    let at = 0;
+    while (at < normalized.length) {
+      let end = normalized.length;
+      let matched = null;
+      while (end > at) {
+        const candidate = `${at > 0 ? '##' : ''}${normalized.slice(at, end)}`;
+        const id = this.vocab.get(candidate);
+        if (Number.isInteger(id)) {
+          matched = { id, start: start + at, end: start + end };
+          break;
+        }
+        end -= 1;
+      }
+      if (!matched) return [{ id: this.unknown, start, end: start + word.length }];
+      pieces.push(matched);
+      at = end;
+    }
+    return pieces;
+  }
+
+  tokenize(textValue) {
+    const text = String(textValue || '');
+    const tokens = [];
+    let wordStart = -1;
+    const flushWord = (end) => {
+      if (wordStart < 0) return;
+      tokens.push(...this.wordPieces(text.slice(wordStart, end), wordStart));
+      wordStart = -1;
+    };
+    for (let index = 0; index < text.length;) {
+      const codePoint = text.codePointAt(index);
+      const character = String.fromCodePoint(codePoint);
+      const width = character.length;
+      if (/\s/u.test(character) || isCjk(codePoint) || isPunctuation(character)) {
+        flushWord(index);
+        if (!/\s/u.test(character)) {
+          tokens.push({ id: this.vocab.get(character) ?? this.unknown, start: index, end: index + width });
+        }
+      } else if (wordStart < 0) {
+        wordStart = index;
+      }
+      index += width;
+    }
+    flushWord(text.length);
+    return tokens;
+  }
