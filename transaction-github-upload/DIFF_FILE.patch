+  font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 1080px; background: var(--paper); color: var(--ink); }
+button, textarea { font: inherit; }
+button { cursor: pointer; }
+.app-shell { min-height: 100vh; }
+.topbar { height: 86px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 30px; border-bottom: 1px solid var(--line); background: rgba(251,250,246,.94); }
+.brand-block { display: flex; align-items: center; gap: 13px; }
+.brand-mark { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 13px; background: var(--green); color: white; font-family: Georgia, serif; font-size: 22px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.15); }
+.brand { font-size: 20px; font-weight: 750; letter-spacing: .12em; }
+.brand-subtitle { margin-top: 3px; color: var(--muted); font-size: 9px; letter-spacing: .2em; }
+.privacy-badge { padding: 9px 16px; border: 1px solid #bdd0c5; border-radius: 99px; color: var(--green); background: #eff6ef; font-size: 13px; }
+.privacy-badge span { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: #4c9d6e; box-shadow: 0 0 0 4px rgba(76,157,110,.12); }
+.top-actions { display: flex; justify-content: flex-end; gap: 10px; }
+.module-nav { min-height: 80px; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 8px; align-items: stretch; padding: 10px 24px; border-bottom: 1px solid var(--line); background: #e8e5dc; }
+.module-nav-item { min-width: 0; display: grid; grid-template-columns: auto minmax(0,1fr); gap: 11px; align-items: center; padding: 10px 13px; border: 1px solid transparent; border-radius: 12px; background: transparent; color: #626a65; text-align: left; }
+.module-nav-item:hover { border-color: #cec9bd; background: rgba(255,255,255,.46); }
+.module-nav-item:focus-visible { outline: 3px solid rgba(23,76,58,.22); outline-offset: 1px; }
+.module-nav-item.active { border-color: #acc3b5; background: var(--panel); color: var(--ink); box-shadow: 0 8px 22px rgba(35,46,40,.07); }
+.module-nav-item > span:last-child { min-width: 0; }
+.module-nav-item strong,.module-nav-item small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.module-nav-item strong { font-size: 13px; }
+.module-nav-item small { margin-top: 3px; color: var(--muted); font-size: 10px; }
+.module-nav-item small b { color: inherit; }
+.module-nav-index { color: #909791; font-family: "Cascadia Mono", monospace; font-size: 10px; font-weight: 700; }
+.module-nav-item.active .module-nav-index { color: var(--green); }
+.button { border: 0; border-radius: 10px; padding: 11px 17px; font-weight: 650; transition: transform .15s ease, background .15s ease; }
+.button:hover { transform: translateY(-1px); }
+.button-dark { color: white; background: var(--ink); }
+.button-accent { color: #172019; background: var(--lime); }
+.button-ghost { border: 1px solid var(--line); background: transparent; color: var(--ink); }
+.button-small { padding: 8px 10px; border-radius: 8px; font-size: 12px; }
+.workspace { display: grid; grid-template-columns: 286px minmax(0,1fr); min-height: calc(100vh - 166px); }
+.sidebar { max-height: calc(100vh - 166px); padding: 30px 24px; overflow-y: auto; border-right: 1px solid var(--line); background: #ebe9e2; }
+.side-section { padding-bottom: 28px; margin-bottom: 26px; border-bottom: 1px solid #d4d0c5; }
+.module-side-guide { padding: 16px; border: 1px solid #c9d2cb; border-radius: 13px; background: rgba(255,255,255,.56); }
+.module-side-guide h2 { margin-bottom: 12px; color: var(--green); }
+.module-side-steps { display: grid; gap: 8px; margin: 0; padding: 0; counter-reset: module-step; list-style: none; }
+.module-side-steps li { display: grid; grid-template-columns: 20px minmax(0,1fr); gap: 7px; align-items: start; color: var(--muted); font-size: 11px; line-height: 1.45; counter-increment: module-step; }
+.module-side-steps li::before { content: counter(module-step); width: 18px; height: 18px; display: grid; place-items: center; border-radius: 50%; background: #dce7df; color: var(--green); font-size: 9px; font-weight: 800; }
+.section-kicker { color: #7a807b; font-size: 11px; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
