+.vault-dialog input { width: 100%; padding: 11px; border: 1px solid #cbc7bc; border-radius: 9px; outline: none; background: white; }
+.vault-dialog input:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(23,76,58,.1); }
+.paste-text-dialog { width: min(680px, calc(100vw - 40px)); }
