+  return history;
+}
+
+function fileNumber(sequence) {
+  return `MI-${String(sequence).padStart(6, '0')}`;
+}
+
+function nextAvailableSequence(used, start = 1) {
+  let value = Math.max(1, Number.isInteger(start) ? start : 1);
+  while (used.has(value)) value += 1;
+  return value;
