+.batch-panel { margin-bottom: 22px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); box-shadow: 0 10px 28px rgba(35,46,40,.06); }
+.batch-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 13px; }
+.batch-heading h2 { margin: 5px 0 0; font-size: 18px; }
