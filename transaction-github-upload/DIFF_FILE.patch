+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const {
+  BertTokenizer,
+  decodeBioEntities,
+  inspectNerModelDirectory
+} = require('../src/services/ner-service.cjs');
+
+const VOCAB = ['[PAD]', '[UNK]', '[CLS]', '[SEP]', '王', '伟', '上', '海', 'alice', '##123', '。'].join('\n');
+
+test('BERT tokenizer preserves UTF-16 source offsets for Chinese and WordPiece tokens', () => {
+  const tokenizer = new BertTokenizer(VOCAB);
+  const tokens = tokenizer.tokenize('王伟 alice123。');
+  assert.deepEqual(tokens.map(({ id, start, end }) => [id, start, end]), [
+    [4, 0, 1], [5, 1, 2], [8, 3, 8], [9, 8, 11], [10, 11, 12]
+  ]);
+});
+
+test('BIO decoder emits accepted and review-required entities from confidence thresholds', () => {
+  const text = '王伟到上海';
+  const tokens = [
+    { start: 0, end: 1 }, { start: 1, end: 2 }, { start: 2, end: 3 }, { start: 3, end: 4 }, { start: 4, end: 5 }
+  ];
+  const entities = decodeBioEntities(text, tokens, ['B-PER', 'I-PER', 'O', 'B-LOC', 'I-LOC'], [0.96, 0.94, 0.99, 0.65, 0.63], {
+    acceptThreshold: 0.78,
+    reviewThreshold: 0.52
+  });
+  assert.deepEqual(entities.map((item) => [item.type, item.value, item.enabled, item.reviewRequired]), [
+    ['person', '王伟', true, false],
+    ['address', '上海', false, true]
+  ]);
+});
+
+test('model directory inspection validates fixed local assets without loading the model', async () => {
+  const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'veilforge-ner-'));
+  try {
+    await fs.writeFile(path.join(directory, 'model.onnx'), Buffer.from([8, 1, 2, 3]));
+    await fs.writeFile(path.join(directory, 'vocab.txt'), VOCAB, 'utf8');
+    await fs.writeFile(path.join(directory, 'config.json'), JSON.stringify({
+      model_type: 'bert',
+      vocab_size: 11,
+      max_position_embeddings: 128,
+      id2label: { 0: 'O', 1: 'B-PER', 2: 'I-PER', 3: 'B-ORG', 4: 'I-ORG', 5: 'B-LOC', 6: 'I-LOC' }
+    }), 'utf8');
+    await assert.rejects(() => inspectNerModelDirectory(directory), /LOCAL_NER_CONFIG_INVALID/);
+
+    const config = JSON.parse(await fs.readFile(path.join(directory, 'config.json'), 'utf8'));
+    config.vocab_size = 100;
+    await fs.writeFile(path.join(directory, 'config.json'), JSON.stringify(config), 'utf8');
+    const inspected = await inspectNerModelDirectory(directory);
+    assert.equal(inspected.model.bytes, 4);
+    assert.equal(inspected.labels.get(1), 'B-PER');
+    assert.match(inspected.modelSha256, /^[a-f0-9]{64}$/u);
+  } finally {
+    await fs.rm(directory, { recursive: true, force: true });
+  }
+});
diff --git a/moyin/tests/ocr-layout.test.mjs b/moyin/tests/ocr-layout.test.mjs
new file mode 100644
index 0000000..1be0c91
--- /dev/null
+++ b/moyin/tests/ocr-layout.test.mjs
@@ -0,0 +1,148 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const {
+  flattenWords,
+  findBoxesForFindings,
+  detectTableRegions,
+  buildCorrectionQueue,
+  applyOcrCorrections,
+  enhancementScale,
+  detectDocumentColumns,
+  rebuildMappedWords,
+  detectTableGrid,
+  recoverMergedGridCells
+} = require('../src/services/ocr-service.cjs');
+const sharp = require('sharp');
+
+test('OCR 单词坐标映射为连续文本偏移', () => {
+  const blocks = [{ paragraphs: [{ lines: [{ words: [
+    { text: '手', confidence: 98, bbox: { x0: 10, y0: 10, x1: 30, y1: 40 } },
+    { text: '机', confidence: 97, bbox: { x0: 32, y0: 10, x1: 52, y1: 40 } },
+    { text: ':', confidence: 96, bbox: { x0: 54, y0: 10, x1: 60, y1: 40 } },
+    { text: '13812345678', confidence: 99, bbox: { x0: 70, y0: 10, x1: 260, y1: 40 } }
+  ] }] }] }];
+  const result = flattenWords(blocks);
+  assert.equal(result.text, '手机:13812345678');
+  assert.equal(result.words[3].start, 3);
+  assert.equal(result.words[3].end, 14);
+});
+
+test('命中区间转换为不可恢复涂黑框', () => {
+  const words = [
+    { start: 0, end: 2, bbox: { x0: 10, y0: 10, x1: 50, y1: 40 } },
+    { start: 2, end: 13, bbox: { x0: 60, y0: 10, x1: 260, y1: 40 } }
+  ];
+  const boxes = findBoxesForFindings(words, [{ start: 2, end: 13, enabled: true }], 300, 100);
+  assert.equal(boxes.length, 1);
+  assert.ok(boxes[0].left < 60);
+  assert.ok(boxes[0].width > 200);
+});
+
+test('取消的命中不会生成涂黑框', () => {
+  const words = [{ start: 0, end: 11, bbox: { x0: 10, y0: 10, x1: 210, y1: 40 } }];
+  assert.deepEqual(findBoxesForFindings(words, [{ start: 0, end: 11, enabled: false }], 300, 100), []);
+});
+
+test('表格区域按稳定列锚点分段并标记单词', () => {
+  const words = [];
+  for (let row = 0; row < 3; row += 1) {
+    for (let column = 0; column < 3; column += 1) {
+      words.push({
+        text: `R${row}C${column}`,
+        confidence: 96,
+        start: words.length * 4,
+        end: words.length * 4 + 4,
+        bbox: { x0: 20 + column * 150, y0: 20 + row * 45, x1: 100 + column * 150, y1: 50 + row * 45 }
+      });
+    }
+  }
+  const regions = detectTableRegions(words, 500, 180);
+  assert.equal(regions.length, 1);
+  assert.equal(regions[0].rows, 3);
+  assert.equal(regions[0].columns, 3);
+});
+
+test('低置信度队列应用人工校正后重建偏移', () => {
+  const words = [
+    { text: '客户', confidence: 98, start: 0, end: 2, lineIndex: 0, bbox: { x0: 10, y0: 10, x1: 60, y1: 40 } },
+    { text: '张二', confidence: 51, start: 2, end: 4, lineIndex: 0, bbox: { x0: 70, y0: 10, x1: 120, y1: 40 } },
+    { text: '电话', confidence: 95, start: 5, end: 7, lineIndex: 1, bbox: { x0: 10, y0: 55, x1: 60, y1: 85 } }
+  ];
+  const queue = buildCorrectionQueue(words, 72);
+  assert.deepEqual(queue.map((item) => item.wordIndex), [1]);
+  const corrected = applyOcrCorrections(words, [{ wordIndex: 1, text: '张三' }]);
+  assert.equal(corrected.text, '客户张三\n电话');
+  assert.equal(corrected.words[1].text, '张三');
+  assert.equal(corrected.words[1].confidence, 100);
+  assert.equal(corrected.words[2].start, 5);
+  assert.equal(corrected.changed, 1);
+});
+
+test('低分辨率增强比例受短边目标和像素预算约束', () => {
+  assert.equal(enhancementScale(1400, 1000), 1);
+  assert.equal(enhancementScale(600, 300), 3);
+  assert.ok(enhancementScale(20000, 500) < 3);
+});
+
+test('双栏文字按左栏到底再进入右栏的阅读顺序重建', () => {
+  const words = [];
+  for (let index = 0; index < 4; index += 1) {
+    words.push({ text: `左${index + 1}`, confidence: 99, bbox: { x0: 20, y0: 20 + index * 50, x1: 90, y1: 40 + index * 50 } });
+    words.push({ text: `右${index + 1}`, confidence: 99, bbox: { x0: 320, y0: 45 + index * 50, x1: 390, y1: 65 + index * 50 } });
+  }
+  const columns = detectDocumentColumns(words, 500, 240);
+  assert.equal(columns.length, 2);
+  const mapped = rebuildMappedWords(words, 0, { width: 500, height: 240 });
+  assert.equal(mapped.readingOrder, 'columns-left-to-right');
+  assert.equal(mapped.text, '左1\n左2\n左3\n左4\n右1\n右2\n右3\n右4');
+});
+
+test('两行对齐双栏在宽装订线下仍按栏重建', () => {
+  const words = [
+    { text: '左客户', confidence: 99, bbox: { x0: 40, y0: 40, x1: 180, y1: 80 } },
+    { text: '张三', confidence: 99, bbox: { x0: 200, y0: 40, x1: 280, y1: 80 } },
+    { text: '左手机', confidence: 99, bbox: { x0: 40, y0: 130, x1: 180, y1: 170 } },
+    { text: '13812345678', confidence: 99, bbox: { x0: 200, y0: 130, x1: 450, y1: 170 } },
+    { text: '右邮箱', confidence: 99, bbox: { x0: 760, y0: 40, x1: 900, y1: 80 } },
+    { text: 'alice@example.com', confidence: 99, bbox: { x0: 920, y0: 40, x1: 1250, y1: 80 } },
+    { text: '右证件', confidence: 99, bbox: { x0: 760, y0: 130, x1: 900, y1: 170 } },
+    { text: '11010519491231002X', confidence: 99, bbox: { x0: 920, y0: 130, x1: 1320, y1: 170 } }
+  ];
+  const columns = detectDocumentColumns(words, 1500, 240);
+  assert.equal(columns.length, 2);
+  const mapped = rebuildMappedWords(words, 0, { width: 1500, height: 240 });
+  assert.equal(mapped.readingOrder, 'columns-left-to-right');
+  assert.match(mapped.text, /alice@example\.com/u);
+  assert.ok(mapped.text.indexOf('13812345678') < mapped.text.indexOf('右邮箱'));
+});
+
+test('网格线检测恢复缺失内隔线对应的合并表头', async () => {
+  const svg = Buffer.from(`<svg xmlns="http://www.w3.org/2000/svg" width="320" height="220">
+    <rect width="320" height="220" fill="white"/>
+    <g stroke="black" stroke-width="3">
+      <path d="M10 10H310M10 75H310M10 140H310M10 205H310"/>
+      <path d="M10 10V205M310 10V205M110 75V205M210 75V205"/>
+    </g>
+  </svg>`);
+  const image = await sharp(svg).png().toBuffer();
+  const tables = await detectTableGrid(image);
+  assert.equal(tables.length, 1);
+  assert.equal(tables[0].rows, 3);
+  assert.equal(tables[0].columns, 3);
+  assert.ok(tables[0].mergedCells >= 1);
+  assert.ok(tables[0].cells.some((cell) => cell.columnSpan === 3 && cell.rowSpan === 1));
+});
+
+test('合并单元格恢复在完整网格上保持每格独立', () => {
+  const width = 21;
+  const height = 21;
+  const raw = Buffer.alloc(width * height, 255);
+  for (const x of [0, 10, 20]) for (let y = 0; y < height; y += 1) raw[y * width + x] = 0;
+  for (const y of [0, 10, 20]) for (let x = 0; x < width; x += 1) raw[y * width + x] = 0;
+  const cells = recoverMergedGridCells([0, 10, 20], [0, 10, 20], raw, width);
+  assert.equal(cells.length, 4);
+  assert.ok(cells.every((cell) => !cell.merged));
+});
diff --git a/moyin/tests/ocr-phase32.test.mjs b/moyin/tests/ocr-phase32.test.mjs
new file mode 100644
index 0000000..01a6081
--- /dev/null
+++ b/moyin/tests/ocr-phase32.test.mjs
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const { CASES, score, aggregate, recallGateStatus } = require('../tools/phase32-ocr-benchmark.cjs');
+const { mappedConfidence, needsQuarterTurnRecovery } = require('../src/services/ocr-service.cjs');
+
+test('Phase32 corpus covers six requested real-world effects', () => {
+  assert.deepEqual(CASES.map((item) => item.id), ['shadow-ticket', 'perspective-ticket', 'stamp-occlusion', 'vertical-text', 'phone-noise', 'multi-column']);
+  assert.deepEqual(CASES.map((item) => item.effect), ['票据阴影', '透视/倾斜', '印章覆盖', '竖排文字', '手机噪声', '多栏穿插']);
+});
+
+test('Phase32 score reports CER, WER and sensitive detection recall', () => {
+  const value = score('客户 13812345678 alice@example.com', '客户 13812345678 alice@example.com', ['13812345678', 'alice@example.com']);
+  assert.equal(value.cer, 0);
+  assert.equal(value.wer, 0);
+  assert.equal(value.sensitiveRecall, 1);
+  const degraded = score('13812345678 alice@example.com', '13812345678', ['13812345678', 'alice@example.com']);
+  assert.equal(degraded.sensitiveRecall, 0.5);
+});
+
+test('Phase32 aggregate computes weighted error and p95 latency', () => {
+  const rows = [
+    { expectedCharacters: 10, charErrors: 1, expectedWords: 4, wordErrors: 1, expectedSensitive: 2, detectedSensitive: 1, elapsedMs: 10, peakRssBytes: 100, enhancementScale: 1, },
+    { expectedCharacters: 20, charErrors: 0, expectedWords: 5, wordErrors: 0, expectedSensitive: 1, detectedSensitive: 1, elapsedMs: 20, peakRssBytes: 120, enhancementScale: 2, },
+    { expectedCharacters: 5, charErrors: 0, expectedWords: 1, wordErrors: 0, expectedSensitive: 0, detectedSensitive: 0, elapsedMs: 40, peakRssBytes: 110, enhancementScale: 1 },
+  ];
+  const result = aggregate(rows);
+  assert.equal(result.cer, 1 / 35);
+  assert.equal(result.wer, 1 / 10);
+  assert.equal(result.detectionRecall, 2 / 3);
+  assert.equal(result.p95ElapsedMs, 40);
+  assert.equal(result.peakRssBytes, 120);
+  assert.equal(result.maxEnhancementScale, 2);
+});
+
+test('Phase32 recall gate targets stamp occlusion and multi-column tokens', () => {
+  const targetCases = CASES.filter((item) => ['stamp-occlusion', 'multi-column'].includes(item.id));
+  assert.equal(targetCases.length, 2);
+  assert.equal(targetCases.flatMap((item) => item.sensitive).length, 5);
+  assert.equal(targetCases.find((item) => item.id === 'multi-column').sensitive.includes('alice@example.com'), true);
+});
+
+test('Phase34 low-confidence mapped words trigger quarter-turn recovery', () => {
+  const degraded = { mapped: { text: '068499V5Z1', words: [{ confidence: 40 }, { confidence: 52 }] } };
+  const reliable = { mapped: { text: 'ID 1234567890', words: [{ confidence: 88 }, { confidence: 92 }] } };
+  assert.equal(mappedConfidence(degraded), 46);
+  assert.equal(needsQuarterTurnRecovery(degraded), true);
+  assert.equal(needsQuarterTurnRecovery(reliable), false);
+});
+
+test('Phase34 recall gate requires Tesseract vertical sensitive recall', () => {
+  const aggregates = { rapidocr: { detectionRecall: 1 }, tesseract: { detectionRecall: 1 } };
+  const targets = [
+    { backend: 'rapidocr', case: 'stamp-occlusion', sensitiveRecall: 1 },
+    { backend: 'rapidocr', case: 'multi-column', sensitiveRecall: 1 },
+    { backend: 'tesseract', case: 'vertical-text', sensitiveRecall: 0 }
+  ];
+  assert.equal(recallGateStatus(aggregates, targets).passed, false);
+  targets[2].sensitiveRecall = 1;
+  assert.deepEqual(recallGateStatus(aggregates, targets), { passed: true, rapidTargetGate: true, tesseractVerticalGate: true });
+});
