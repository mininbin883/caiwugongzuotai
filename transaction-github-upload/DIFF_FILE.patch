+      name: `blob-${attachment.sha256}`,
+      kind: 'file-blob',
+      text: '',
+      mapping: [],
+      audit: { findingCount: 0, findingTypes: [], tokenCount: 0 },
+      attachment,
+      attachments: [],
+      dataBase64
