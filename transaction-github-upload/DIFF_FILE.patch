+.type-person { background: #b26f3d; }
+.type-mobile { background: #3d8b68; }
+.type-idcard { background: #b7654c; }
+.type-uscc { background: #8b563e; }
+.type-email { background: #6b70ad; }
+.type-bankcard { background: #c59a3c; }
+.type-address { background: #927b35; }
+.type-ipv4 { background: #50879b; }
+.type-landline { background: #8b6c99; }
+.type-custom { background: #333c38; }
+.segmented { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; background: #ddd9ce; border-radius: 11px; }
