+    cMapPacked: true,
+    standardFontDataUrl: directoryUrl(pdfAssetDirectory('standard_fonts')),
+    wasmUrl: directoryUrl(pdfAssetDirectory('wasm')),
+    useSystemFonts: true,
+    isEvalSupported: false,
+    enableXfa: false
