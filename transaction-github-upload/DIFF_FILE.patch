+.batch-list { display: grid; gap: 7px; max-height: 224px; overflow-y: auto; }
+.batch-row { display: grid; grid-template-columns: 10px minmax(0,1fr) auto; align-items: center; gap: 12px; padding: 10px 11px; border: 1px solid #e0ddd4; border-radius: 10px; background: #f8f7f2; }
