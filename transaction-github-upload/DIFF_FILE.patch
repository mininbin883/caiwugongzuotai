+.empty-state { min-height: 470px; display: grid; place-items: center; align-content: center; padding: 70px; border: 1px dashed #bcb8ac; border-radius: 20px; background: rgba(255,255,255,.35); text-align: center; }
+.empty-symbol { width: 86px; height: 104px; display: grid; place-items: center; margin-bottom: 23px; border: 1px solid #b2b9b4; border-radius: 8px 21px 8px 8px; background: var(--panel); color: var(--green); font-family: Georgia, serif; font-size: 32px; box-shadow: var(--shadow); transform: rotate(-2deg); }
