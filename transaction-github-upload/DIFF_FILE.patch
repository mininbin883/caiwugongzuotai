+    ? entry.findingTypes.map(String).slice(0, 10000)
+    : Array.isArray(entry?.audit?.findingTypes) ? entry.audit.findingTypes.map(String).slice(0, 10000) : [];
+  const kind = requestedKind === 'reversible-map' ? 'reversible-map' : 'redacted-text';
