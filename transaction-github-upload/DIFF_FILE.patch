+  const native = await extractNativePdfText(inputPath);
+  const report = officeTokenFindings(native.text, normalized);
+  if (!report.findings.length) throw new Error('LOCAL_PDF_REVERSIBLE_TOKENS_NOT_FOUND');
+  const present = new Set(report.findings.map((finding) => finding.value));
+  const sidecar = await readCoordinateSidecar(sidecarPath);
+  if (!sidecar || sidecar.pageCount !== native.pageCount) throw new Error('LOCAL_PDF_REVERSIBLE_SIDECAR_REQUIRED');
+  const output = await PDFDocument.create();
+  let restoredCoordinates = 0;
+  for (const sidecarPage of sidecar.pages) {
+    const backgroundFile = String(sidecarPage.backgroundFile || '');
+    if (!backgroundFile || path.basename(backgroundFile) !== backgroundFile || !backgroundFile.toLowerCase().endsWith('.png')) {
+      throw new Error('LOCAL_PDF_REVERSIBLE_SIDECAR_INVALID');
+    }
+    const pageWidth = Number(sidecarPage.width);
+    const pageHeight = Number(sidecarPage.height);
+    const pdfWidth = Number(sidecarPage.pdfWidth);
+    const pdfHeight = Number(sidecarPage.pdfHeight);
+    if (![pageWidth, pageHeight, pdfWidth, pdfHeight].every((value) => Number.isFinite(value) && value > 0)) {
+      throw new Error('LOCAL_PDF_REVERSIBLE_SIDECAR_INVALID');
+    }
+    const backgroundPath = path.join(path.dirname(path.resolve(sidecarPath)), backgroundFile);
+    const placements = (sidecarPage.placements || [])
+      .filter((placement) => present.has(placement.token) && byToken.has(placement.token))
+      .map((placement) => ({
+        token: placement.token,
+        value: byToken.get(placement.token).value,
+        left: Number(placement.left),
+        top: Number(placement.top),
+        width: Number(placement.width),
+        height: Number(placement.height)
+      }));
+    restoredCoordinates += placements.length;
+    const background = await pageWithBlankedPlacements({
+      image: await fs.readFile(backgroundPath),
+      width: pageWidth,
+      height: pageHeight
+    }, placements, true);
+    const embedded = await output.embedPng(background);
+    const page = output.addPage([pdfWidth, pdfHeight]);
+    page.drawImage(embedded, { x: 0, y: 0, width: pdfWidth, height: pdfHeight });
+  }
+  if (!restoredCoordinates) throw new Error('LOCAL_PDF_REVERSIBLE_COORDINATES_NOT_FOUND');
+  const bytes = await output.save({ useObjectStreams: false, addDefaultPage: false });
+  await fs.writeFile(outputPath, bytes);
+  return {
+    kind: 'pdf',
+    pages: sidecar.pages.length,
+    bytes: bytes.length,
+    knownTokens: report.knownTokens,
+    restoredOccurrences: report.restoredOccurrences,
+    restoredCoordinates,
+    missingTokens: report.missingTokens,
+    repeatedTokens: report.repeatedTokens,
+    unknownTokens: report.unknownTokens,
+    complete: report.complete,
+    coordinateSidecarUsed: true,
+    visualRestoration: true
+  };
+}
+
+module.exports = {
+  MAX_PDF_BYTES,
+  MAX_PDF_PAGES,
+  recognizePdf,
+  renderRedactedPdf,
+  renderTokenizedPdf,
+  restoreReversiblePdf,
+  extractNativePdfText,
+  inspectPdfFeatures,
+  inspectPdfCompatibility,
+  inspectPdfBytes,
+  inspectPdfDocument,
+  createPdfResigningRequest,
+  nativePageText,
+  pdfFindingPlacements,
+  renderPage,
+  renderScale
+};
diff --git a/moyin/src/services/pdf-signing-service.cjs b/moyin/src/services/pdf-signing-service.cjs
new file mode 100644
index 0000000..7ec7b46
--- /dev/null
+++ b/moyin/src/services/pdf-signing-service.cjs
@@ -0,0 +1,77 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { PDFDocument } = require('pdf-lib');
+const signpdf = require('@signpdf/signpdf').default;
+const { pdflibAddPlaceholder } = require('@signpdf/placeholder-pdf-lib');
+const { P12Signer } = require('@signpdf/signer-p12');
+const { Signer, SUBFILTER_ETSI_CADES_DETACHED } = require('@signpdf/utils');
+
+class CallbackSigner extends Signer {
+  constructor(callback, metadata = {}) {
+    super();
+    if (typeof callback !== 'function') throw new Error('LOCAL_PDF_SIGNER_CALLBACK_INVALID');
+    this.callback = callback;
+    this.metadata = { adapter: 'pkcs11-hsm-callback', ...metadata };
+  }
+
+  async sign(pdfBuffer, signingTime) {
+    const signature = await this.callback(Buffer.from(pdfBuffer), { signingTime, ...this.metadata });
+    if (!Buffer.isBuffer(signature) && !(signature instanceof Uint8Array)) throw new Error('LOCAL_PDF_SIGNER_RESULT_INVALID');
+    return Buffer.from(signature);
+  }
+}
+
+function signingOptions(options = {}) {
+  return {
+    reason: String(options.reason || 'Post-redaction approval'),
+    contactInfo: String(options.contactInfo || ''),
+    name: String(options.name || 'VeilForge signer'),
+    location: String(options.location || ''),
+    signingTime: options.signingTime instanceof Date ? options.signingTime : new Date(),
+    signatureLength: Number.isInteger(options.signatureLength) ? options.signatureLength : 16384,
+    subFilter: options.subFilter || SUBFILTER_ETSI_CADES_DETACHED,
+    widgetRect: Array.isArray(options.widgetRect) ? options.widgetRect : [0, 0, 0, 0],
+    appName: 'VeilForge Local Redactor'
+  };
+}
+
+async function preparePdfForSigning(pdfBytes, options = {}) {
+  const document = await PDFDocument.load(pdfBytes, { updateMetadata: false });
+  pdflibAddPlaceholder({ pdfDoc: document, ...signingOptions(options) });
+  return Buffer.from(await document.save({ useObjectStreams: false, addDefaultPage: false, updateFieldAppearances: false }));
+}
+
+async function signPdfBuffer(pdfBytes, signer, options = {}) {
+  if (!Buffer.isBuffer(pdfBytes) && !(pdfBytes instanceof Uint8Array)) throw new Error('LOCAL_PDF_SIGN_INPUT_INVALID');
+  if (!signer || typeof signer.sign !== 'function') throw new Error('LOCAL_PDF_SIGNER_INVALID');
+  const prepared = await preparePdfForSigning(Buffer.from(pdfBytes), options);
+  return Buffer.from(await signpdf.sign(prepared, signer, options.signingTime));
+}
+
+async function signPdfWithP12(inputPath, outputPath, certificatePath, password = '', options = {}) {
+  for (const value of [inputPath, outputPath, certificatePath]) if (typeof value !== 'string' || !path.isAbsolute(value)) throw new Error('LOCAL_PATH_INVALID');
+  const [pdfBytes, certificateBytes] = await Promise.all([fs.readFile(inputPath), fs.readFile(certificatePath)]);
+  const signer = new P12Signer(certificateBytes, { passphrase: String(password || '') });
+  const signed = await signPdfBuffer(pdfBytes, signer, options);
+  await fs.writeFile(outputPath, signed, { flag: options.overwrite ? 'w' : 'wx', mode: 0o600 });
+  return { adapter: 'p12', bytes: signed.length, outputPath };
+}
+
+async function signPdfWithExternalSigner(inputPath, outputPath, callback, options = {}) {
+  for (const value of [inputPath, outputPath]) if (typeof value !== 'string' || !path.isAbsolute(value)) throw new Error('LOCAL_PATH_INVALID');
+  const pdfBytes = await fs.readFile(inputPath);
+  const signer = new CallbackSigner(callback, options.metadata);
+  const signed = await signPdfBuffer(pdfBytes, signer, options);
+  await fs.writeFile(outputPath, signed, { flag: options.overwrite ? 'w' : 'wx', mode: 0o600 });
+  return { adapter: signer.metadata.adapter, bytes: signed.length, outputPath };
+}
+
+module.exports = {
+  CallbackSigner,
+  preparePdfForSigning,
+  signPdfBuffer,
+  signPdfWithP12,
+  signPdfWithExternalSigner
+};
diff --git a/moyin/src/services/pdf-validation-service.cjs b/moyin/src/services/pdf-validation-service.cjs
new file mode 100644
index 0000000..4ad1ad1
--- /dev/null
+++ b/moyin/src/services/pdf-validation-service.cjs
@@ -0,0 +1,72 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { execFile } = require('node:child_process');
+const { promisify } = require('node:util');
+const execFileAsync = promisify(execFile);
+
+async function executableExists(value) {
+  if (!value) return false;
+  if (path.isAbsolute(value)) return fs.access(value).then(() => true, () => false);
+  return true;
+}
+
+function findCompliance(value) {
+  if (!value || typeof value !== 'object') return null;
+  for (const key of ['isCompliant', 'compliant']) if (typeof value[key] === 'boolean') return value[key];
+  for (const child of Object.values(value)) {
+    const result = findCompliance(child);
+    if (result !== null) return result;
+  }
+  return null;
+}
+
+async function validatePdfA(filePath, options = {}) {
+  if (typeof filePath !== 'string' || !path.isAbsolute(filePath)) throw new Error('LOCAL_PATH_INVALID');
+  const executable = String(options.executable || process.env.VEILFORGE_VERAPDF || 'verapdf');
+  const args = ['--format', 'json', '--maxfailures', String(options.maxFailures || 100)];
+  if (options.flavour) args.push('--flavour', String(options.flavour));
+  if (options.password) args.push('--password', String(options.password));
+  args.push(filePath);
+  const runner = options.runner || (async (command, commandArgs) => execFileAsync(command, commandArgs, {
+    windowsHide: true,
+    timeout: Number(options.timeoutMs || 120000),
+    maxBuffer: 16 * 1024 * 1024
+  }));
+  if (path.isAbsolute(executable) && !(await executableExists(executable))) {
+    return { validator: 'veraPDF', available: false, executed: false, compliant: null, executable, reason: 'VERAPDF_NOT_INSTALLED' };
+  }
+  try {
+    const result = await runner(executable, args);
+    const stdout = String(result?.stdout || '');
+    const report = JSON.parse(stdout);
+    return {
+      validator: 'veraPDF',
+      available: true,
+      executed: true,
+      compliant: findCompliance(report),
+      executable,
+      args: args.filter((value, index) => args[index - 1] !== '--password'),
+      report
+    };
+  } catch (error) {
+    if (error?.code === 'ENOENT') return { validator: 'veraPDF', available: false, executed: false, compliant: null, executable, reason: 'VERAPDF_NOT_INSTALLED' };
+    const stdout = String(error?.stdout || '');
+    let report = null;
+    try { report = stdout ? JSON.parse(stdout) : null; } catch {}
+    return {
+      validator: 'veraPDF',
+      available: true,
+      executed: true,
+      compliant: findCompliance(report),
+      executable,
+      exitCode: Number(error?.code) || 1,
+      reason: 'VERAPDF_VALIDATION_FAILED',
+      report,
+      stderr: String(error?.stderr || '').slice(0, 4096)
+    };
+  }
+}
+
+module.exports = { validatePdfA, findCompliance };
diff --git a/moyin/src/services/rapidocr-service.cjs b/moyin/src/services/rapidocr-service.cjs
new file mode 100644
index 0000000..f6aee1c
--- /dev/null
+++ b/moyin/src/services/rapidocr-service.cjs
@@ -0,0 +1,170 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { spawn } = require('node:child_process');
+const { inspectModelPack, findFirstModelPack } = require('./model-pack-service.cjs');
+const { inspectRuntimePack, findBundledRuntimePack } = require('./runtime-pack-service.cjs');
+
+const RESULT_FORMAT = 'VEILFORGE_RAPIDOCR_RESULT_V1';
+const MAX_STDOUT_BYTES = 16 * 1024 * 1024;
+const MAX_STDERR_BYTES = 2 * 1024 * 1024;
+const DEFAULT_TIMEOUT_MS = 120000;
+
+function bridgePath() {
+  if (process.env.VEILFORGE_RAPIDOCR_BRIDGE) return path.resolve(process.env.VEILFORGE_RAPIDOCR_BRIDGE);
+  if (process.resourcesPath && !process.defaultApp) return path.join(process.resourcesPath, 'tools', 'rapidocr-bridge.py');
+  return path.resolve(__dirname, '../../tools/rapidocr-bridge.py');
+}
+
+function resolveExplicitPython(options = {}) {
+  const value = options.pythonPath || process.env.VEILFORGE_RAPIDOCR_PYTHON;
+  if (!value) return null;
+  if (typeof value !== 'string' || !path.isAbsolute(value)) throw new Error('LOCAL_RAPIDOCR_PYTHON_NOT_CONFIGURED');
+  const resolved = path.resolve(value);
+  if (!fs.statSync(resolved, { throwIfNoEntry: false })?.isFile()) throw new Error('LOCAL_RAPIDOCR_PYTHON_INVALID');
+  return resolved;
+}
+
+async function resolvePython(options = {}) {
+  const explicit = resolveExplicitPython(options);
+  if (explicit) return { python: explicit, runtimePack: null, packagesDir: String(options.packagesDir || process.env.PYTHONPATH || '') };
+  const runtimePack = options.runtimeDirectory
+    ? await inspectRuntimePack(path.resolve(options.runtimeDirectory))
+    : await findBundledRuntimePack();
+  if (!runtimePack) throw new Error('LOCAL_RAPIDOCR_RUNTIME_PACK_MISSING');
+  return { python: runtimePack.entry, runtimePack, packagesDir: runtimePack.packagesDir };
+}
+
+function bboxFromPolygon(value) {
+  if (!Array.isArray(value) || value.length < 4) throw new Error('LOCAL_RAPIDOCR_RESULT_INVALID');
+  const xs = value.map((point) => Number(point?.[0]));
+  const ys = value.map((point) => Number(point?.[1]));
+  if ([...xs, ...ys].some((number) => !Number.isFinite(number))) throw new Error('LOCAL_RAPIDOCR_RESULT_INVALID');
+  return {
+    x0: Math.max(0, Math.round(Math.min(...xs))),
+    y0: Math.max(0, Math.round(Math.min(...ys))),
+    x1: Math.max(1, Math.round(Math.max(...xs))),
+    y1: Math.max(1, Math.round(Math.max(...ys)))
+  };
+}
+
+function normalizeResult(payload) {
+  if (!payload || payload.format !== RESULT_FORMAT || !Number.isInteger(payload.width) || !Number.isInteger(payload.height) ||
+      payload.width < 1 || payload.height < 1 || !Array.isArray(payload.words)) throw new Error('LOCAL_RAPIDOCR_RESULT_INVALID');
+  const words = payload.words.map((word) => {
+    const text = String(word?.text || '').trim();
+    const confidence = Number(word?.confidence);
+    if (!text || !Number.isFinite(confidence)) throw new Error('LOCAL_RAPIDOCR_RESULT_INVALID');
+    return { text, confidence: Math.max(0, Math.min(100, confidence <= 1 ? confidence * 100 : confidence)), bbox: bboxFromPolygon(word.box) };
+  });
+  if (!words.length) throw new Error('LOCAL_OCR_EMPTY');
+  const lineRecords = [];
+  for (const line of Array.isArray(payload.lines) ? payload.lines : []) {
+    const text = String(line?.text || '').trim();
+    if (!text || !Array.isArray(line?.box)) continue;
+    try {
+      const confidence = Number(line?.confidence || 0);
+      lineRecords.push({ text, confidence: Math.max(0, Math.min(100, confidence <= 1 ? confidence * 100 : confidence)), bbox: bboxFromPolygon(line.box) });
+    } catch { /* Word boxes remain authoritative when an optional line box is malformed. */ }
+  }
+  return {
+    width: payload.width,
+    height: payload.height,
+    elapsedSeconds: Number(payload.elapsedSeconds || 0),
+    words,
+    lines: Array.isArray(payload.lines) ? payload.lines.length : 0,
+    lineRecords
+  };
+}
+
+async function rapidOcrModelPack(options = {}) {
+  if (options.modelDirectory) return inspectModelPack(path.resolve(options.modelDirectory), 'ocr');
+  if (process.env.VEILFORGE_RAPIDOCR_PACK) return inspectModelPack(path.resolve(process.env.VEILFORGE_RAPIDOCR_PACK), 'ocr');
+  const pack = await findFirstModelPack('ocr');
+  if (!pack) throw new Error('LOCAL_RAPIDOCR_MODEL_PACK_MISSING');
+  return pack;
+}
+
+async function inspectRapidOcrBackend(options = {}) {
+  const [runtime, pack] = await Promise.all([resolvePython(options), rapidOcrModelPack(options)]);
+  const bridge = path.resolve(options.bridgePath || bridgePath());
+  if (!fs.statSync(bridge, { throwIfNoEntry: false })?.isFile()) throw new Error('LOCAL_RAPIDOCR_BRIDGE_MISSING');
+  return {
+    backend: 'rapidocr-ppocrv6',
+    python: runtime.python,
+    bridge,
+    packagesDir: runtime.packagesDir,
+    runtimePack: runtime.runtimePack ? {
+      id: runtime.runtimePack.id,
+      name: runtime.runtimePack.name,
+      version: runtime.runtimePack.version,
+      pythonVersion: runtime.runtimePack.pythonVersion,
+      engine: runtime.runtimePack.engine,
+      manifestSha256: runtime.runtimePack.manifestSha256,
+      files: runtime.runtimePack.files,
+      bytes: runtime.runtimePack.bytes
+    } : null,
+    modelPack: { id: pack.id, name: pack.name, version: pack.version, manifestSha256: pack.manifestSha256, bytes: pack.bytes },
+    pack
+  };
+}
+
+async function recognizeWithRapidOcr(source, options = {}) {
+  if (!Buffer.isBuffer(source) && !(source instanceof Uint8Array)) throw new Error('LOCAL_IMAGE_BUFFER_INVALID');
+  const backend = await inspectRapidOcrBackend(options);
+  const timeoutMs = Math.max(1000, Math.min(10 * 60 * 1000, Number(options.timeoutMs) || DEFAULT_TIMEOUT_MS));
+  const child = spawn(backend.python, [backend.bridge, '--models', backend.pack.directory], {
+    shell: false,
+    windowsHide: true,
+    stdio: ['pipe', 'pipe', 'pipe'],
+    cwd: backend.runtimePack?.directory || path.dirname(backend.python),
+    env: {
+      ...process.env,
+      ...(backend.packagesDir ? { PYTHONPATH: backend.packagesDir } : {}),
+      PYTHONUTF8: '1',
+      PYTHONIOENCODING: 'utf-8'
+    }
+  });
+  const stdout = [];
+  const stderr = [];
+  let stdoutBytes = 0;
+  let stderrBytes = 0;
+  const result = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      child.kill();
+      reject(new Error('LOCAL_RAPIDOCR_TIMEOUT'));
+    }, timeoutMs);
+    child.on('error', (error) => { clearTimeout(timer); reject(new Error(`LOCAL_RAPIDOCR_SPAWN_FAILED:${error.message}`)); });
+    child.stdout.on('data', (chunk) => {
+      stdoutBytes += chunk.length;
+      if (stdoutBytes > MAX_STDOUT_BYTES) child.kill();
+      else stdout.push(chunk);
+    });
+    child.stderr.on('data', (chunk) => {
+      stderrBytes += chunk.length;
+      if (stderrBytes <= MAX_STDERR_BYTES) stderr.push(chunk);
+    });
+    child.on('close', (code) => {
+      clearTimeout(timer);
+      if (stdoutBytes > MAX_STDOUT_BYTES) return reject(new Error('LOCAL_RAPIDOCR_OUTPUT_TOO_LARGE'));
+      if (code !== 0) return reject(new Error(`LOCAL_RAPIDOCR_FAILED:${code}:${Buffer.concat(stderr).toString('utf8').slice(0, 1000)}`));
+      try { resolve(normalizeResult(JSON.parse(Buffer.concat(stdout).toString('utf8')))); }
+      catch (error) { reject(error); }
+    });
+    child.stdin.on('error', () => {});
+    child.stdin.end(Buffer.from(source));
+  });
+  return { ...result, backend: backend.backend, modelPack: backend.modelPack, runtimePack: backend.runtimePack };
+}
+
+module.exports = {
+  RESULT_FORMAT,
+  bridgePath,
+  resolveExplicitPython,
+  resolvePython,
+  normalizeResult,
+  rapidOcrModelPack,
+  inspectRapidOcrBackend,
+  recognizeWithRapidOcr
+};
diff --git a/moyin/src/services/resource-budget-service.cjs b/moyin/src/services/resource-budget-service.cjs
new file mode 100644
index 0000000..675c728
--- /dev/null
+++ b/moyin/src/services/resource-budget-service.cjs
@@ -0,0 +1,158 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+
+const MiB = 1024 * 1024;
+const GiB = 1024 * MiB;
+
+const CAPACITY_PROFILES = Object.freeze({
+  parity: Object.freeze({
+    name: 'parity',
+    maxInputBytes: 100 * MiB,
+    maxPdfPages: 300,
+    maxScanPages: 100,
+    maxScanCharacters: 60_000,
+    maxWorkspaceBytes: 2 * GiB,
+    maxRssBytes: Math.floor(1.5 * GiB),
+    minimumFreeBytes: 128 * MiB
+  }),
+  exceed: Object.freeze({
+    name: 'exceed',
+    maxInputBytes: 200 * MiB,
+    maxPdfPages: 500,
+    maxScanPages: 200,
+    maxScanCharacters: 150_000,
+    maxWorkspaceBytes: 4 * GiB,
+    maxRssBytes: 2 * GiB,
+    minimumFreeBytes: 256 * MiB
+  })
+});
+
+function positiveInteger(value, fallback) {
+  return Number.isSafeInteger(value) && value > 0 ? value : fallback;
+}
+
+function profileWithOverrides(profile, overrides = {}) {
+  const source = typeof profile === 'string' ? CAPACITY_PROFILES[profile] : profile;
+  if (!source) throw new Error('LOCAL_RESOURCE_PROFILE_INVALID');
+  return Object.freeze({
+    name: String(overrides.name || source.name),
+    maxInputBytes: positiveInteger(overrides.maxInputBytes, source.maxInputBytes),
+    maxPdfPages: positiveInteger(overrides.maxPdfPages, source.maxPdfPages),
+    maxScanPages: positiveInteger(overrides.maxScanPages, source.maxScanPages),
+    maxScanCharacters: positiveInteger(overrides.maxScanCharacters, source.maxScanCharacters),
+    maxWorkspaceBytes: positiveInteger(overrides.maxWorkspaceBytes, source.maxWorkspaceBytes),
+    maxRssBytes: positiveInteger(overrides.maxRssBytes, source.maxRssBytes),
+    minimumFreeBytes: positiveInteger(overrides.minimumFreeBytes, source.minimumFreeBytes)
+  });
+}
+
+function assertNotAborted(signal) {
+  if (signal?.aborted) {
+    const error = new Error('LOCAL_JOB_ABORTED');
+    error.cause = signal.reason;
+    throw error;
+  }
+}
+
+function statfsFreeBytes(value) {
+  const blockSize = BigInt(value?.bsize ?? value?.frsize ?? 0);
+  const available = BigInt(value?.bavail ?? value?.bfree ?? 0);
+  const bytes = blockSize * available;
+  return bytes > BigInt(Number.MAX_SAFE_INTEGER) ? Number.MAX_SAFE_INTEGER : Number(bytes);
+}
+
+function createResourceBudget(options = {}) {
+  const profile = profileWithOverrides(options.profile || 'parity', options);
+  const memoryUsage = options.memoryUsage || process.memoryUsage;
+  const statfs = options.statfs || fs.statfs;
+  const samples = [];
+  let peakRssBytes = 0;
+  let peakHeapUsedBytes = 0;
+
+  function assertInputBytes(bytes) {
+    if (!Number.isSafeInteger(bytes) || bytes < 0) throw new Error('LOCAL_RESOURCE_SIZE_INVALID');
+    if (bytes > profile.maxInputBytes) throw new Error('LOCAL_FILE_TOO_LARGE');
+    return bytes;
+  }
+
+  function assertPdfPages(pages) {
+    if (!Number.isSafeInteger(pages) || pages < 1 || pages > profile.maxPdfPages) {
+      throw new Error('LOCAL_PDF_PAGE_COUNT_INVALID');
+    }
+    return pages;
+  }
+
+  function assertScan(pages, characters) {
+    if (!Number.isSafeInteger(pages) || pages < 1 || pages > profile.maxScanPages) {
+      throw new Error('LOCAL_SCAN_PAGE_COUNT_INVALID');
+    }
+    if (!Number.isSafeInteger(characters) || characters < 0 || characters > profile.maxScanCharacters) {
+      throw new Error('LOCAL_SCAN_TEXT_TOO_LARGE');
+    }
+  }
+
+  function assertWorkspaceBytes(bytes) {
+    if (!Number.isSafeInteger(bytes) || bytes < 0 || bytes > profile.maxWorkspaceBytes) {
+      throw new Error('LOCAL_WORKSPACE_BUDGET_EXCEEDED');
+    }
+    return bytes;
+  }
+
+  async function assertDiskSpace(directory, anticipatedBytes = 0) {
+    assertWorkspaceBytes(anticipatedBytes);
+    let freeBytes = null;
+    try {
+      freeBytes = statfsFreeBytes(await statfs(directory));
+    } catch (error) {
+      if (!['ENOSYS', 'ENOTSUP', 'EINVAL'].includes(error?.code)) throw error;
+    }
+    if (freeBytes !== null && freeBytes < anticipatedBytes + profile.minimumFreeBytes) {
+      throw new Error('LOCAL_DISK_BUDGET_EXCEEDED');
+    }
+    return { checked: freeBytes !== null, freeBytes, anticipatedBytes, minimumFreeBytes: profile.minimumFreeBytes };
+  }
+
+  function sample(label = 'sample') {
+    const usage = memoryUsage();
+    const rss = Number(usage.rss || 0);
+    const heapUsed = Number(usage.heapUsed || 0);
+    peakRssBytes = Math.max(peakRssBytes, rss);
+    peakHeapUsedBytes = Math.max(peakHeapUsedBytes, heapUsed);
+    const record = { label: String(label), rssBytes: rss, heapUsedBytes: heapUsed };
+    samples.push(record);
+    if (samples.length > 512) samples.shift();
+    if (rss > profile.maxRssBytes) throw new Error('LOCAL_MEMORY_BUDGET_EXCEEDED');
+    return record;
+  }
+
+  function snapshot() {
+    return {
+      profile,
+      peakRssBytes,
+      peakHeapUsedBytes,
+      samples: samples.slice()
+    };
+  }
+
+  return Object.freeze({
+    profile,
+    assertInputBytes,
+    assertPdfPages,
+    assertScan,
+    assertWorkspaceBytes,
+    assertDiskSpace,
+    assertNotAborted,
+    sample,
+    snapshot
+  });
+}
+
+module.exports = {
+  MiB,
+  GiB,
+  CAPACITY_PROFILES,
+  createResourceBudget,
+  assertNotAborted,
+  statfsFreeBytes
+};
diff --git a/moyin/src/services/runtime-pack-service.cjs b/moyin/src/services/runtime-pack-service.cjs
new file mode 100644
index 0000000..d1bcc6f
--- /dev/null
+++ b/moyin/src/services/runtime-pack-service.cjs
@@ -0,0 +1,106 @@
+'use strict';
+
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+
+const RUNTIME_PACK_FORMAT = 'VEILFORGE_RUNTIME_PACK_V1';
+const MAX_MANIFEST_BYTES = 2 * 1024 * 1024;
+const MAX_RUNTIME_FILES = 10000;
+const MAX_RUNTIME_BYTES = 1024 * 1024 * 1024;
+
+function sha256File(filePath) {
+  return new Promise((resolve, reject) => {
+    const hash = createHash('sha256');
+    const stream = fs.createReadStream(filePath);
+    stream.on('error', reject);
+    stream.on('data', (chunk) => hash.update(chunk));
+    stream.on('end', () => resolve(hash.digest('hex')));
+  });
+}
+
+function safeRelative(value) {
+  const normalized = String(value || '').replace(/\\/gu, '/');
+  if (!normalized || path.isAbsolute(normalized) || normalized.startsWith('/') || normalized.split('/').includes('..')) {
+    throw new Error('LOCAL_RUNTIME_PACK_PATH_INVALID');
+  }
+  return normalized;
+}
+
+function runtimePackRoot() {
+  if (process.env.VEILFORGE_RUNTIME_PACK_ROOT) return path.resolve(process.env.VEILFORGE_RUNTIME_PACK_ROOT);
+  if (process.resourcesPath && !process.defaultApp) return path.join(process.resourcesPath, 'runtime-packs');
+  return path.resolve(__dirname, '../../runtime-packs');
+}
+
+async function inspectRuntimePack(directory) {
+  if (typeof directory !== 'string' || !path.isAbsolute(directory)) throw new Error('LOCAL_RUNTIME_PACK_DIRECTORY_INVALID');
+  const resolved = path.resolve(directory);
+  const manifestPath = path.join(resolved, 'manifest.json');
+  const stat = await fsp.stat(manifestPath).catch(() => null);
+  if (!stat?.isFile() || stat.size < 2 || stat.size > MAX_MANIFEST_BYTES) throw new Error('LOCAL_RUNTIME_PACK_MANIFEST_MISSING');
+  let manifest;
+  try { manifest = JSON.parse(await fsp.readFile(manifestPath, 'utf8')); }
+  catch { throw new Error('LOCAL_RUNTIME_PACK_MANIFEST_INVALID'); }
+  if (manifest?.format !== RUNTIME_PACK_FORMAT || manifest.kind !== 'python-ocr-runtime' ||
+      !/^[a-z0-9][a-z0-9._-]{2,63}$/u.test(String(manifest.id || '')) ||
+      manifest.platform !== 'win32' || manifest.arch !== 'x64' ||
+      !Array.isArray(manifest.files) || manifest.files.length < 10 || manifest.files.length > MAX_RUNTIME_FILES) {
+    throw new Error('LOCAL_RUNTIME_PACK_MANIFEST_INVALID');
+  }
+  const seen = new Set();
+  let bytes = 0;
+  for (const item of manifest.files) {
+    item.path = safeRelative(item.path);
+    if (seen.has(item.path) || !Number.isInteger(item.bytes) || item.bytes < 0 ||
+        !/^[a-f0-9]{64}$/u.test(String(item.sha256 || ''))) throw new Error('LOCAL_RUNTIME_PACK_MANIFEST_INVALID');
+    seen.add(item.path);
+    bytes += item.bytes;
+  }
+  const entry = safeRelative(manifest.entry);
+  const packagesDir = safeRelative(manifest.packagesDir);
+  for (const required of [entry, 'LICENSE-PYTHON.txt', 'LICENSE-RAPIDOCR.txt', 'NOTICE.txt', 'SBOM.json']) {
+    if (!seen.has(required)) throw new Error(`LOCAL_RUNTIME_PACK_REQUIRED_FILE_MISSING:${required}`);
+  }
+  if (bytes > MAX_RUNTIME_BYTES) throw new Error('LOCAL_RUNTIME_PACK_TOO_LARGE');
+  for (const item of manifest.files) {
+    const filePath = path.resolve(resolved, item.path);
+    if (!filePath.startsWith(`${resolved}${path.sep}`)) throw new Error('LOCAL_RUNTIME_PACK_PATH_INVALID');
+    const fileStat = await fsp.stat(filePath).catch(() => null);
+    if (!fileStat?.isFile() || fileStat.size !== item.bytes) throw new Error(`LOCAL_RUNTIME_PACK_SIZE_MISMATCH:${item.path}`);
+    if (await sha256File(filePath) !== item.sha256) throw new Error(`LOCAL_RUNTIME_PACK_HASH_MISMATCH:${item.path}`);
+  }
+  return {
+    directory: resolved,
+    manifestPath,
+    manifestSha256: await sha256File(manifestPath),
+    id: manifest.id,
+    name: String(manifest.name || manifest.id),
+    version: String(manifest.version || ''),
+    pythonVersion: String(manifest.python || ''),
+    engine: String(manifest.engine || ''),
+    entry: path.join(resolved, entry),
+    packagesDir: path.join(resolved, packagesDir),
+    files: manifest.files.length,
+    bytes,
+    manifest
+  };
+}
+
+async function findBundledRuntimePack(root = runtimePackRoot()) {
+  const entries = await fsp.readdir(root, { withFileTypes: true }).catch(() => []);
+  for (const entry of entries.filter((item) => item.isDirectory()).sort((a, b) => a.name.localeCompare(b.name))) {
+    try { return await inspectRuntimePack(path.join(root, entry.name)); }
+    catch { /* Ignore invalid candidates and keep searching. */ }
+  }
+  return null;
+}
+
+module.exports = {
+  RUNTIME_PACK_FORMAT,
+  runtimePackRoot,
+  inspectRuntimePack,
+  findBundledRuntimePack,
+  sha256File
+};
