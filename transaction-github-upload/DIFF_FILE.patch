+    if (dark >= Math.max(80, width * 0.32)) horizontal.push(y);
+  }
+  for (let x = 0; x < width; x += 1) {
+    let dark = 0;
+    for (let y = 0; y < height; y += 1) dark += analyzed.data[y * width + x] < GRID_DARK_THRESHOLD ? 1 : 0;
