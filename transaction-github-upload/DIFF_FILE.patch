+    const cleanResources = context.obj({});
+    const updatedFontValue = updatedResources?.get(PDFName.of('Font')) || originalFontValue;
+    if (updatedFontValue) {
+      cleanResources.set(PDFName.of('Font'), updatedFontValue);
