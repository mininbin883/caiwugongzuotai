+.document-header { display: flex; justify-content: space-between; gap: 30px; align-items: flex-end; margin-bottom: 26px; }
+.document-header h1 { max-width: 700px; margin: 7px 0 5px; overflow: hidden; text-overflow: ellipsis; font-size: 26px; white-space: nowrap; }
+.document-header p { margin-bottom: 0; color: var(--muted); font-size: 13px; }
+.metrics { display: flex; gap: 10px; }
+.metric { min-width: 82px; padding: 11px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); text-align: center; }
+.metric strong { display: block; font-size: 20px; }
+.metric span { color: var(--muted); font-size: 11px; }
+.metric.accent { border-color: #c8dc84; background: #edf6cb; }
+.workflow-guide { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)) auto; gap: 10px; align-items: stretch; margin: 0 0 22px; padding: 0; list-style: none; }
+.workflow-guide > li { display: flex; gap: 10px; align-items: center; min-width: 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 13px; background: rgba(255,255,255,.45); color: var(--muted); }
