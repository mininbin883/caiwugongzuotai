+}
+
+async function atomicReplace(targetPath, replacementPath) {
+  const suffix = randomUUID();
+  const previous = `${targetPath}.${suffix}.previous`;
+  let moved = false;
+  try {
+    await fs.rename(targetPath, previous);
+    moved = true;
