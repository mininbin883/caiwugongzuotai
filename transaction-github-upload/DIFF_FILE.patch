+  if (!expectedText.every((value) => ocr.text.includes(value))) throw new Error(`IMAGE_TO_TEXT_CONTENT_MISMATCH:${ocr.text}`);
+  const textPath = path.join(root, 'output', 'phase27', 'image-to-text.txt');
