+.paste-text-dialog textarea:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(23,76,58,.1); }
+.paste-text-counter { color: var(--muted); font-size: 10px; text-align: right; }
+.vault-dialog-error { min-height: 18px; color: #8a3f35; font-size: 11px; }
+.vault-dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 3px; }
+.main-panel { padding: 34px 38px 50px; overflow: hidden; }
+.module-overview { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(300px,.9fr) auto; gap: 28px; align-items: center; margin-bottom: 22px; padding: 28px 30px; border: 1px solid #bdd0c5; border-radius: 18px; background: linear-gradient(135deg,#f8faf4,#edf4ed); box-shadow: var(--shadow); }
