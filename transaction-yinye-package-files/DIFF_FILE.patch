+  git -C "$ROOT" push --force-with-lease origin "$ORIGINAL_HEAD:main"
+fi
+ACTUAL="$(git -C "$ROOT" rev-parse HEAD)"
+[[ "$ACTUAL" == "$ORIGINAL_HEAD" ]]
+echo "ROLLBACK_OK mode=${MODE#--} root=$ROOT head=$ACTUAL"
